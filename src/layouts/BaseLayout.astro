---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
  noFooter?: boolean;
}

const {
  title = 'The Sovereign Ledger | AlternaVest Capital',
  description = 'Access exclusive alternative investment frameworks designed for the discerning capital allocator. Precision, transparency, and institutional-grade rigor.',
  currentPage = '',
  noFooter = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Manrope:wght@200;300;400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />

  <!-- Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
</head>
<body class="bg-surface text-on-surface selection:bg-tertiary-fixed selection:text-on-tertiary-fixed">
  <Navbar currentPage={currentPage} />

  <main class="pt-[72px] mobile-nav-pad page-transition">
    <slot />
  </main>

  {!noFooter && <Footer />}

  <MobileNav currentPage={currentPage} />

  <!-- Modal host — populated by site-interactive.js -->
  <div id="site-modals"></div>

  <!-- Site-wide interactive features -->
  <script is:inline src="/site-interactive.js"></script>
</body>
</html>
