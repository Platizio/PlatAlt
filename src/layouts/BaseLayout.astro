---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import { SITE, absUrl, routeKey } from '../config/site';
import { resolveSeo } from '../data/seo';
import { organizationNode, websiteNode, breadcrumbNode } from '../data/schema';
import '../styles/global.css';

export interface Props {
  /** Explicit override. Omit and the route's entry in src/data/seo.ts wins. */
  title?: string;
  description?: string;
  currentPage?: string;
  /**
   * Absolute URL. Omit and it is derived from the current route. Set to point
   * elsewhere when a page defers to another — see CANONICAL_MAP in seo.ts.
   */
  canonical?: string;
  /** Root-relative or absolute. */
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Trail for BreadcrumbList. The last item should carry no `item`. */
  breadcrumbs?: { name: string; item?: string }[];
  /** Extra JSON-LD nodes merged into this page's @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title: titleProp,
  description: descProp,
  currentPage = '',
  canonical: canonicalProp,
  image,
  ogType = 'website',
  noindex: noindexProp,
  breadcrumbs = [],
  schema = [],
} = Astro.props;

const path = routeKey(Astro.url.pathname);
const entry = resolveSeo(path);

// `astro build` is the only automated gate in this repo, so an unmapped route
// has to fail it. Without this throw, a renamed or added page silently falls
// back to a shared default description — which is exactly the bug this whole
// change exists to fix (72 of 73 pages shipped the same string before it).
if (!entry && !descProp) {
  throw new Error(
    `[seo] No entry in src/data/seo.ts for "${path}", and no description prop was ` +
      'passed. Add the route to SEO, or pass description={...} to BaseLayout.',
  );
}

const title = titleProp ?? entry!.title;
const description = descProp ?? entry!.description;
const canonical = canonicalProp ?? entry?.canonical ?? absUrl(path);
const noindex = noindexProp ?? entry?.noindex ?? false;
/**
 * Share card. Falls back to the site-wide card rather than to nothing: a link
 * pasted into WhatsApp — the actual distribution channel for a distributor-facing
 * site — previews as a bare card without one, and no page passes `image` today.
 *
 * public/og-image.png is 1200x630 and draws the wordmark at its native 467x54,
 * so it is pixel-exact rather than an enlargement. Dimensions are only asserted
 * for that default, since a page-supplied image may be any size.
 */
const DEFAULT_OG_IMAGE = '/og-image.png';
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, SITE.url).href;
const ogImageIsDefault = !image;

const graph = [
  organizationNode(),
  websiteNode(),
  ...(breadcrumbs.length ? [breadcrumbNode(breadcrumbs)] : []),
  ...schema,
];
---

<!DOCTYPE html>
<html lang="en-IN" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex
    ? <meta name="robots" content="noindex,follow" />
    : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}

  {/*
    Icons. The mark is the wordmark's own 'P', cropped from public/logo.png at its
    real 36x51 extent, so it is the firm's artwork rather than a substitute
    letterform. /logo.png itself is 467x54 — a wide wordmark squeezed into a square
    tab icon is unreadable, and browsers still requested /favicon.ico and 404'd.
  */}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0f1c2c" />

  {/*
    Form delivery, read by public/site-interactive.js. That file is copied
    verbatim into dist/ and never sees Astro, so it cannot import
    src/config/site.ts; these two tags are the bridge. The key is a Web3Forms
    client-side form key and is public by design — see the note in site.ts.
  */}
  <meta name="w3f-endpoint" content={SITE.form.endpoint} />
  <meta name="w3f-key" content={SITE.form.accessKey} />
  <meta name="site-phone" content={SITE.telephone} />
  <meta name="site-phone-href" content={SITE.telephoneHref} />

  {/* Open Graph */}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title} />
  {ogImageIsDefault && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )}

  {/* Twitter. There is always an image now, so always the large card. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {/* Google Fonts */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Manrope:wght@200;300;400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />

  {/*
    Material Symbols.

    `display=block`, not `swap`. Icons here are ligature text — the element
    literally contains the word "home" — so a swap period paints the
    identifier before the font arrives. Measured on a 375px viewport: an icon
    goes from 22px wide to 56.6px, which pushes the fixed bottom nav past the
    viewport edge. `block` keeps the text unpainted while the font loads.

    That covers the block period. It does not cover the font never arriving,
    which is what the guard below is for.
  */}
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet" />

  {/*
    Icon-font guard. Until the face is confirmed loaded, .material-symbols-outlined
    is held at a 1em box with its text hidden (see global.css), so a blocked or
    failed request costs the icons but never the layout. On success this class
    removes the override entirely, so the normal path renders exactly as before.

    If the font genuinely never loads the icons stay blank rather than
    reverting to words: every icon is aria-hidden and every icon-only control
    carries an aria-label, so nothing here is the sole carrier of meaning.
  */}
  <script is:inline>
    (function () {
      var d = document;
      var FAMILY = '"Material Symbols Outlined"';
      var reveal = function () { d.documentElement.classList.add('icons-ready'); };

      /*
        Measure, do not ask. document.fonts.check() answers "is every face I
        know of for this family loaded?", and when the Google stylesheet is
        blocked the document knows of none — so it answers yes for a family
        that will paint as the default serif. Verified by aborting
        fonts.googleapis.com in a headless run: check() returned true,
        .icons-ready went on, and every span rendered its ligature text at the
        size the guard exists to prevent.

        A Material Symbols glyph advances exactly 1em; the literal word never
        does. One measurement settles it with no reliance on the API's answer.
      */
      function ligatureFormed() {
        if (!d.body) return false;
        var probe = d.createElement('span');
        probe.textContent = 'home';
        probe.setAttribute(
          'style',
          'position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre;font:100px ' + FAMILY,
        );
        d.body.appendChild(probe);
        var w = probe.getBoundingClientRect().width;
        probe.parentNode.removeChild(probe);
        /* 100px once the glyph resolves; 200px+ as four letters in any fallback. */
        return w > 0 && w < 150;
      }

      function settle() {
        if (d.body) { if (ligatureFormed()) reveal(); return; }
        d.addEventListener('DOMContentLoaded', function () {
          if (ligatureFormed()) reveal();
        }, { once: true });
      }

      /* No Font Loading API: reveal rather than hide icons behind a guard we
         cannot verify. The guard is an enhancement, not a correctness rule. */
      if (!d.fonts || !d.fonts.load) { reveal(); return; }

      d.fonts.load('24px ' + FAMILY).catch(function () { /* measured below either way */ }).then(settle);
      d.fonts.ready && d.fonts.ready.then(settle).catch(function () {});
    })();
  </script>
  <noscript><style>.material-symbols-outlined{visibility:visible!important;width:auto!important;overflow:visible!important}</style></noscript>

  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
</head>
<body class="bg-surface text-on-surface selection:bg-tertiary-fixed selection:text-on-tertiary-fixed">
  {/*
    Bypass block (WCAG 2.4.1). The header carries up to 29 links once the
    Products and Knowledge menus open on focus, and every one of them sat
    between a keyboard user and the page content on all 76 pages.
    Off-screen until focused — see .skip-link in global.css.
  */}
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <Navbar currentPage={currentPage} />

  <main id="main-content" tabindex="-1" class="pt-[72px] page-transition">
    <slot />
  </main>

  <Footer />

  <MobileNav currentPage={currentPage} />

  {/* Modal host — populated by site-interactive.js */}
  <div id="site-modals"></div>

  {/* Site-wide interactive features */}
  <script is:inline src="/site-interactive.js"></script>
</body>
</html>
