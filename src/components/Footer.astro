    <div class="pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-400 text-[10px] uppercase tracking-widest">© 2026 Platizio Alternatives. All rights reserved.</p>
      <div class="flex flex-wrap gap-6 text-slate-400 text-[10px] uppercase tracking-widest">
        <a class="hover:text-brand-navy transition-colors" href="/terms">Terms</a>
        <a class="hover:text-brand-navy transition-colors" href="/privacy">Privacy</a>
