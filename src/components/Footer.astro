<footer class="bg-slate-50 text-brand-navy py-20 px-6 border-t border-slate-200">
  <div class="container mx-auto max-w-7xl">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <!-- Brand -->
      <div class="col-span-2">
        <div class="mb-6">
          <img src="/logo.png" alt="Platizio Alternatives" class="h-7 w-auto" />
        </div>
        <p class="text-slate-500 font-light max-w-sm mb-8 text-sm leading-relaxed">
