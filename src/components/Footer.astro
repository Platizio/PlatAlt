---
import { SITE } from '../config/site';
---
<footer class="bg-slate-50 text-brand-navy py-20 px-6 border-t border-slate-200">
  <div class="container mx-auto max-w-7xl">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <!-- Brand -->
      <div class="col-span-2">
        <div class="mb-6">
          <img src="/logo.png" alt="Platizio Alternatives" width="467" height="54"
               loading="lazy" decoding="async" class="h-7 w-auto" />
        </div>
        {/*
          Rewritten 2026-08-13. The previous sentence named the brand as a
          division of itself (the parent's name was lost in an earlier rename),
          and asserted an adviser registration with no number on every page,
          contradicting regulatory-disclosure.astro. The line below states the
          position Platizio publishes at platizio.com.

          Write notes like this as a JSX-style expression comment, never as an
          HTML comment: Astro emits HTML comments into dist/, so a note that
          quotes the string it just removed re-publishes that string on all 76
          pages and trips the grep gate in the design spec.
        */}
        <p class="text-slate-500 font-light max-w-sm mb-6 text-sm leading-relaxed">
          The PMS and AIF arm of <a href={SITE.parent.url} rel="noopener" class="text-brand-navy hover:text-brand-orange transition-colors">{SITE.parent.legalName}</a>, focused on institutional-grade discovery for family offices, high-net-worth allocators and distributors.
        </p>
        <p class="text-slate-400 text-[11px] uppercase tracking-widest mb-8">
          AMFI Registered &middot; SEBI Compliant
        </p>

        <address class="not-italic text-slate-500 text-sm font-light space-y-3 mb-8">
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-orange mb-1">Head Office</span>
            {SITE.address.streetAddress}, {SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}
          </div>
          <div class="flex flex-wrap gap-x-5 gap-y-1">
            <a href={`tel:${SITE.telephoneHref}`} class="hover:text-brand-navy transition-colors">{SITE.telephone}</a>
            <a href={`mailto:${SITE.email}`} class="hover:text-brand-navy transition-colors">{SITE.email}</a>
          </div>
        </address>

        <div class="flex gap-4">
          <a href={`mailto:${SITE.email}`} aria-label="Email Platizio Alternatives"
             class="w-10 h-10 border border-slate-300 flex items-center justify-center text-slate-500 hover:bg-brand-orange hover:text-white hover:border-brand-orange transition-all">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">mail</span>
          </a>
          <a href={SITE.youtube} rel="noopener" aria-label="Platizio Alternatives on YouTube"
             class="w-10 h-10 border border-slate-300 flex items-center justify-center text-slate-500 hover:bg-brand-orange hover:text-white hover:border-brand-orange transition-all">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">play_circle</span>
          </a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h5 class="font-bold text-[10px] uppercase tracking-[0.3em] text-brand-orange mb-6">Products</h5>
        <ul class="space-y-3 text-slate-500 text-sm font-light">
          <li><a class="hover:text-brand-navy transition-colors" href="/explore">Fund Explorer</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/compare">Compare Funds</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/amc">AMC Directory</a></li>
          <!-- These point at the knowledge pages, not /funds/<strategy>: those
               canonicalise here, and a sitewide link into a canonicalised URL
               contradicts the canonical on every page of the site. -->
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/aif/category-i/venture-capital">Venture Capital Funds</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/aif/category-ii/private-equity">Private Equity Funds</a></li>
        </ul>
      </div>

      <!-- Knowledge & Company -->
      <div>
        <h5 class="font-bold text-[10px] uppercase tracking-[0.3em] text-brand-orange mb-6">Knowledge</h5>
        <ul class="space-y-3 text-slate-500 text-sm font-light mb-8">
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/aif">AIF Knowledge Center</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/pms">PMS Knowledge Centre</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/pms-vs-aif-vs-mutual-fund">PMS vs AIF vs Mutual Fund</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/aif-taxation">AIF Taxation in India</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/media">Market Insights</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/gift-city">GIFT City IFSC</a></li>
        </ul>
        <h5 class="font-bold text-[10px] uppercase tracking-[0.3em] text-brand-orange mb-4">Company</h5>
        <ul class="space-y-3 text-slate-500 text-sm font-light">
          <li><a class="hover:text-brand-navy transition-colors" href="/about">About Us</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/partner">Partner With Us</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-400 text-[10px] uppercase tracking-widest">© 2026 Platizio Alternatives. All rights reserved.</p>
      <div class="flex flex-wrap gap-6 text-slate-400 text-[10px] uppercase tracking-widest">
        <a class="hover:text-brand-navy transition-colors" href="/terms">Terms</a>
        <a class="hover:text-brand-navy transition-colors" href="/privacy">Privacy</a>
        <a class="hover:text-brand-navy transition-colors" href="/regulatory-disclosure">Disclosures</a>
        <a class="hover:text-brand-navy transition-colors" href="/risk-disclaimer">Risk Disclaimer</a>
      </div>
    </div>
  </div>
</footer>
