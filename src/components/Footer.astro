          <li><a class="hover:text-brand-navy transition-colors" href="/funds/venture-capital">Venture Capital</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/funds/private-equity">Private Equity</a></li>
        </ul>
      </div>

      <!-- Knowledge & Company -->
      <div>
        <h5 class="font-bold text-[10px] uppercase tracking-[0.3em] text-brand-orange mb-6">Knowledge</h5>
        <ul class="space-y-3 text-slate-500 text-sm font-light mb-8">
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/aif">AIF Knowledge Center</a></li>
          <li><a class="hover:text-brand-navy transition-colors" href="/knowledge/pms">PMS Knowledge Centre</a></li>
