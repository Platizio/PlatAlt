---
export interface Props {
  currentPage?: string;
}
const { currentPage = '' } = Astro.props;

const isActive = (page: string) => currentPage === page || currentPage.startsWith(page + '/');

const items = [
  { href: '/',          icon: 'home',            label: 'Home',      page: 'home'      },
  { href: '/explore',   icon: 'account_balance', label: 'Products',  page: 'products'  },
  { href: '/knowledge/aif', icon: 'menu_book',   label: 'Knowledge', page: 'knowledge' },
  { href: '/about',     icon: 'info',            label: 'About',     page: 'about'     },
  { href: '/login',     icon: 'person',          label: 'Login',     page: 'login'     },
];
---

<nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-2 pb-safe pt-3 bg-slate-900/95 backdrop-blur-xl border-t border-slate-700/50 shadow-[0_-4px_24px_rgba(0,0,0,0.3)]"
     style="padding-bottom: max(1.5rem, env(safe-area-inset-bottom));">
  {items.map(item => {
    const active = isActive(item.page) || (item.page === 'home' && currentPage === 'home');
    return (
      <a href={item.href}
         class={`flex flex-col items-center justify-center gap-0.5 px-3 py-1 transition-all ${active ? 'text-amber-200 scale-110' : 'text-slate-500 hover:text-slate-300'}`}>
        <span class="material-symbols-outlined text-xl"
              style={active ? "font-variation-settings:'FILL' 1,'wght' 300,'GRAD' 0,'opsz' 24" : ""}>
          {item.icon}
        </span>
        <span class="text-[9px] font-semibold uppercase tracking-wider">{item.label}</span>
      </a>
    );
  })}
</nav>
