---
import { PMS_MANDATES } from '../data/pms-mandates';

export interface Props {
  currentPage?: string;
}
const { currentPage = '' } = Astro.props;

const isActive = (page: string) => currentPage === page;
const isSection = (section: string) => currentPage.startsWith(section);

/*
 * One source for both menus.
 *
 * The desktop mega menu and the hamburger menu were written separately and had
 * drifted: the header offered 30 destinations, the mobile menu 10. The whole
 * AIF category taxonomy — the site's main content cluster — was reachable only
 * with a mouse. Rendering both from these constants is what stops that
 * recurring; adding a link below now adds it to both, or to neither.
 */
const TOOLS = [
  { href: '/explore', icon: 'search', label: 'Fund Explorer' },
  { href: '/compare', icon: 'compare_arrows', label: 'Compare Funds' },
  { href: '/amc', icon: 'corporate_fare', label: 'AMC Directory' },
];

const AIF_GROUPS = [
  {
    title: 'Category I AIF',
    hub: '/knowledge/aif/category-i',
    items: [
      { href: '/knowledge/aif/category-i/venture-capital', label: 'Venture Capital' },
      { href: '/knowledge/aif/category-i/angel', label: 'Angel Funds' },
      { href: '/knowledge/aif/category-i/infrastructure', label: 'Infrastructure' },
      { href: '/knowledge/aif/category-i/social-venture', label: 'Social Venture' },
      { href: '/knowledge/aif/category-i/sme', label: 'SME Funds' },
    ],
  },
  {
    title: 'Category II AIF',
    hub: '/knowledge/aif/category-ii',
    items: [
      { href: '/knowledge/aif/category-ii/private-equity', label: 'Private Equity' },
      { href: '/knowledge/aif/category-ii/debt', label: 'Debt Funds' },
      { href: '/knowledge/aif/category-ii/real-estate', label: 'Real Estate' },
      { href: '/knowledge/aif/category-ii/distressed-assets', label: 'Distressed Assets' },
    ],
  },
  {
    title: 'Category III AIF',
    hub: '/knowledge/aif/category-iii',
    items: [
      { href: '/knowledge/aif/category-iii/long-only', label: 'Long Only' },
      { href: '/knowledge/aif/category-iii/long-short', label: 'Long Short' },
      { href: '/knowledge/aif/category-iii/multi-strategy', label: 'Multi Strategy' },
      { href: '/knowledge/aif/category-iii/long-short-market-neutral', label: 'Market Neutral' },
    ],
  },
];

/* `indent` marks the PMS mandate spokes, which sit under their hub in both menus. */
const KNOWLEDGE = [
  { href: '/knowledge/aif', icon: 'school', label: 'AIF Knowledge Center' },
  { href: '/knowledge/pms', icon: 'analytics', label: 'PMS Knowledge Centre' },
  ...PMS_MANDATES.map((m) => ({ href: `/knowledge/pms/${m.key}`, label: m.name, indent: true })),
  { href: '/knowledge/aif-comparison', icon: 'compare', label: 'AIF Comparison' },
  { href: '/knowledge/pms-vs-aif-vs-mutual-fund', icon: 'balance', label: 'PMS vs AIF vs Mutual Fund' },
  { href: '/knowledge/aif-taxation', icon: 'receipt_long', label: 'AIF Taxation' },
  { href: '/media', icon: 'article', label: 'Videos & Guides' },
  { href: '/gift-city', icon: 'location_city', label: 'GIFT City IFSC' },
];

const PRIMARY = [
  { href: '/about', label: 'About', page: 'about' },
  { href: '/partner', label: 'Partner', page: 'partner' },
  { href: '/contact', label: 'Contact', page: 'contact' },
];

const productsActive =
  isSection('products') || isSection('funds') || isActive('explore') || isActive('compare') || isActive('amc');
const knowledgeActive = isSection('knowledge') || isActive('media') || isActive('gift-city');

const deskLink = 'text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors';
const mobLink = 'block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100';
const mobSub = 'block py-2.5 pl-4 text-[11px] tracking-wide text-slate-500 hover:text-brand-orange border-b border-slate-100';
---

<header class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-xl shadow-sm border-b border-slate-100">
  <div class="flex justify-between items-center px-6 lg:px-10 py-4 max-w-screen-2xl mx-auto w-full">

    {/* Logo */}
    <a href="/" class="flex items-center shrink-0">
      <img src="/logo.png" alt="Platizio Alternatives" width="467" height="54"
           fetchpriority="high" decoding="async" class="h-8 w-auto" />
    </a>

    {/* Desktop Nav */}
    <nav class="hidden lg:flex items-center gap-1">

      {/* Home */}
      <a href="/"
         class={`px-4 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive('home') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
        Home
      </a>

      {/* Products Dropdown */}
      <div class="nav-item relative group px-1">
        <button type="button" aria-haspopup="true" aria-expanded="false" class={`flex items-center gap-1 px-3 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${productsActive ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
          Products
          <span aria-hidden="true" class="material-symbols-outlined text-sm">expand_more</span>
        </button>
        <div class="nav-dropdown hidden group-hover:block pt-2">
          <div class="bg-white border border-slate-200 shadow-2xl min-w-[820px] grid grid-cols-4 gap-0">
            {/* Tools */}
            <div class="p-6 border-r border-slate-200">
              <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-4">Tools</p>
              <ul class="space-y-2">
                {TOOLS.map((t) => (
                  <li><a href={t.href} class={`flex items-center gap-2 ${deskLink}`}><span aria-hidden="true" class="material-symbols-outlined text-sm">{t.icon}</span>{t.label}</a></li>
                ))}
              </ul>
            </div>
            {AIF_GROUPS.map((g, i) => (
              <div class={i < AIF_GROUPS.length - 1 ? 'p-6 border-r border-slate-200' : 'p-6'}>
                <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-1">{g.title}</p>
                <a href={g.hub} class="text-brand-orange/50 text-[9px] tracking-wide hover:text-brand-orange/80 transition-colors block mb-3">View all →</a>
                <ul class="space-y-1.5">
                  {g.items.map((it) => (
                    <li><a href={it.href} class={`${deskLink} block`}>{it.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Knowledge Dropdown */}
      <div class="nav-item relative group px-1">
        <button type="button" aria-haspopup="true" aria-expanded="false" class={`flex items-center gap-1 px-3 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${knowledgeActive ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
          Knowledge
          <span aria-hidden="true" class="material-symbols-outlined text-sm">expand_more</span>
        </button>
        <div class="nav-dropdown hidden group-hover:block pt-2">
          <div class="bg-white border border-slate-200 shadow-2xl min-w-[280px]">
            <div class="p-6 space-y-2">
              {KNOWLEDGE.map((k, i) => (
                <a href={k.href}
                   class={`flex items-center gap-3 ${k.indent ? 'pl-7 text-slate-500' : 'text-slate-600'} hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5${i < KNOWLEDGE.length - 1 ? ' border-b border-slate-100' : ''}`}>
                  {k.icon && <span aria-hidden="true" class="material-symbols-outlined text-sm">{k.icon}</span>}
                  {k.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      {PRIMARY.map((p) => (
        <a href={p.href}
           class={`px-4 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive(p.page) ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
          {p.label}
        </a>
      ))}
    </nav>

    {/* Right Actions */}
    <div class="flex items-center gap-3">
      <button type="button"
              class="js-open-consult bg-brand-orange text-white px-5 py-2 text-[11px] font-bold uppercase tracking-widest hover:bg-brand-orange-dark transition-all active:scale-95 hidden md:inline-flex items-center cursor-pointer">
        Consult
      </button>
      {/* Mobile Hamburger */}
      <button id="mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" class="lg:hidden text-brand-navy p-1" aria-label="Menu">
        <span aria-hidden="true" class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  {/*
    Mobile Slide-down Menu.

    The two groups are <details>, not a JS accordion: the whole taxonomy is
    ~30 links and an undifferentiated list of that length is unusable on a
    phone, while <details> is keyboard-operable and open-by-default-on-find
    without a line of script. Capped in height and scrollable so the list
    cannot run off the bottom of a short viewport. `mobile-nav-pad` keeps the
    last entries clear of the fixed bottom bar, which otherwise sits on top of
    them once the list is scrolled to its end.
  */}
  <div id="mobile-menu" class="mobile-nav-pad hidden lg:hidden bg-white border-t border-slate-100 px-6 pb-6 pt-4 max-h-[calc(100dvh-72px)] overflow-y-auto overscroll-contain">
    <nav class="space-y-1">
      <a href="/" class={mobLink}>Home</a>

      <details class="group/mob border-b border-slate-100">
        <summary class="flex items-center justify-between py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 cursor-pointer list-none marker:hidden">
          Products
          <span aria-hidden="true" class="material-symbols-outlined text-base transition-transform group-open/mob:rotate-180">expand_more</span>
        </summary>
        <div class="pb-2">
          {TOOLS.map((t) => (
            <a href={t.href} class={`${mobSub} flex items-center gap-2`}>
              <span aria-hidden="true" class="material-symbols-outlined text-sm">{t.icon}</span>{t.label}
            </a>
          ))}
          {AIF_GROUPS.map((g) => (
            <>
              <a href={g.hub} class="block pt-4 pb-2 text-[9px] font-bold uppercase tracking-widest text-brand-orange/70 hover:text-brand-orange">{g.title} →</a>
              {g.items.map((it) => (
                <a href={it.href} class={mobSub}>{it.label}</a>
              ))}
            </>
          ))}
        </div>
      </details>

      <details class="group/mob border-b border-slate-100">
        <summary class="flex items-center justify-between py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 cursor-pointer list-none marker:hidden">
          Knowledge
          <span aria-hidden="true" class="material-symbols-outlined text-base transition-transform group-open/mob:rotate-180">expand_more</span>
        </summary>
        <div class="pb-2">
          {KNOWLEDGE.map((k) => (
            <a href={k.href} class={`${mobSub}${k.indent ? ' pl-8 text-slate-400' : ''} flex items-center gap-2`}>
              {k.icon && <span aria-hidden="true" class="material-symbols-outlined text-sm">{k.icon}</span>}
              {k.label}
            </a>
          ))}
        </div>
      </details>

      {PRIMARY.map((p) => (
        <a href={p.href} class={mobLink}>{p.label}</a>
      ))}
      <a href="/partner" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-brand-orange">Partner With Us</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  btn?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') === true));

  /* Escape closes it and hands focus back, so a keyboard user is not stranded
     inside a 30-link list with no way out but Tab. */
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || menu?.classList.contains('hidden')) return;
    setMenu(false);
    btn?.focus();
  });

  /* A tap outside the header should dismiss it, the way every other menu on a
     phone behaves. */
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('hidden')) return;
    const t = e.target as Node;
    if (btn?.contains(t) || menu?.contains(t)) return;
    setMenu(false);
  });

  /*
   * The Products and Knowledge menus are opened by CSS — :hover on .nav-item
   * and, for keyboard users, :focus-within (see global.css). Because nothing
   * in JS opened them, the trigger's aria-expanded would have been a static
   * lie. This mirrors the CSS state onto the attribute so it stays true.
   */
  document.querySelectorAll('.nav-item').forEach((item) => {
    const trigger = item.querySelector('button');
    if (!trigger) return;
    const sync = (open: boolean) => trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    item.addEventListener('mouseenter', () => sync(true));
    item.addEventListener('mouseleave', () => sync(item.contains(document.activeElement)));
    item.addEventListener('focusin', () => sync(true));
    item.addEventListener('focusout', () => {
      /* focusout fires before focus lands, so check on the next tick. */
      setTimeout(() => sync(item.contains(document.activeElement)), 0);
    });
  });
</script>
