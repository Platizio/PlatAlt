---
export interface Props {
  currentPage?: string;
}
const { currentPage = '' } = Astro.props;

const isActive = (page: string) => currentPage === page;
const isSection = (section: string) => currentPage.startsWith(section);
---

<header class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-xl shadow-sm border-b border-slate-100">
  <div class="flex justify-between items-center px-6 lg:px-10 py-4 max-w-screen-2xl mx-auto w-full">

    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0">
      <img src="/logo.png" alt="Platizio Alternatives" class="h-8 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-1">

      <!-- Home -->
      <a href="/"
         class={`px-4 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive('home') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
        Home
      </a>

      <!-- Products Dropdown -->
      <div class="nav-item relative group px-1">
        <button class={`flex items-center gap-1 px-3 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isSection('products') || isSection('funds') || isActive('explore') || isActive('compare') || isActive('amc') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
          Products
          <span class="material-symbols-outlined text-sm">expand_more</span>
        </button>
        <div class="nav-dropdown hidden group-hover:block pt-2">
          <div class="bg-white border border-slate-200 shadow-2xl min-w-[820px] grid grid-cols-4 gap-0">
            <!-- Tools -->
            <div class="p-6 border-r border-slate-200">
              <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-4">Tools</p>
              <ul class="space-y-2">
                <li><a href="/explore" class="flex items-center gap-2 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors"><span class="material-symbols-outlined text-sm">search</span>Fund Explorer</a></li>
                <li><a href="/compare" class="flex items-center gap-2 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors"><span class="material-symbols-outlined text-sm">compare_arrows</span>Compare Funds</a></li>
                <li><a href="/amc" class="flex items-center gap-2 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors"><span class="material-symbols-outlined text-sm">corporate_fare</span>AMC Directory</a></li>
              </ul>
            </div>
            <!-- Cat I AIF -->
            <div class="p-6 border-r border-slate-200">
              <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-1">Category I AIF</p>
              <a href="/knowledge/aif/category-i" class="text-brand-orange/50 text-[9px] tracking-wide hover:text-brand-orange/80 transition-colors block mb-3">View all →</a>
              <ul class="space-y-1.5">
                <li><a href="/knowledge/aif/category-i/venture-capital" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Venture Capital</a></li>
                <li><a href="/knowledge/aif/category-i/angel" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Angel Funds</a></li>
                <li><a href="/knowledge/aif/category-i/infrastructure" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Infrastructure</a></li>
                <li><a href="/knowledge/aif/category-i/social-venture" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Social Venture</a></li>
                <li><a href="/knowledge/aif/category-i/sme" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">SME Funds</a></li>
              </ul>
            </div>
            <!-- Cat II AIF -->
            <div class="p-6 border-r border-slate-200">
              <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-1">Category II AIF</p>
              <a href="/knowledge/aif/category-ii" class="text-brand-orange/50 text-[9px] tracking-wide hover:text-brand-orange/80 transition-colors block mb-3">View all →</a>
              <ul class="space-y-1.5">
                <li><a href="/knowledge/aif/category-ii/private-equity" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Private Equity</a></li>
                <li><a href="/knowledge/aif/category-ii/debt" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Debt Funds</a></li>
                <li><a href="/knowledge/aif/category-ii/real-estate" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Real Estate</a></li>
                <li><a href="/knowledge/aif/category-ii/distressed-assets" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Distressed Assets</a></li>
              </ul>
            </div>
            <!-- Cat III AIF -->
            <div class="p-6">
              <p class="text-brand-orange/70 text-[9px] font-bold uppercase tracking-widest mb-1">Category III AIF</p>
              <a href="/knowledge/aif/category-iii" class="text-brand-orange/50 text-[9px] tracking-wide hover:text-brand-orange/80 transition-colors block mb-3">View all →</a>
              <ul class="space-y-1.5">
                <li><a href="/knowledge/aif/category-iii/long-only" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Long Only</a></li>
                <li><a href="/knowledge/aif/category-iii/long-short" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Long Short</a></li>
                <li><a href="/knowledge/aif/category-iii/multi-strategy" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Multi Strategy</a></li>
                <li><a href="/knowledge/aif/category-iii/long-short-market-neutral" class="text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors block">Market Neutral</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Knowledge Dropdown -->
      <div class="nav-item relative group px-1">
        <button class={`flex items-center gap-1 px-3 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isSection('knowledge') || isActive('media') || isActive('gift-city') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
          Knowledge
          <span class="material-symbols-outlined text-sm">expand_more</span>
        </button>
        <div class="nav-dropdown hidden group-hover:block pt-2">
          <div class="bg-white border border-slate-200 shadow-2xl min-w-[280px]">
            <div class="p-6 space-y-2">
              <a href="/knowledge/aif" class="flex items-center gap-3 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5 border-b border-slate-100">
                <span class="material-symbols-outlined text-sm">school</span> AIF Knowledge Center
              </a>
              <a href="/knowledge/pms" class="flex items-center gap-3 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5 border-b border-slate-100">
                <span class="material-symbols-outlined text-sm">analytics</span> PMS Knowledge Centre
              </a>
              <a href="/knowledge/aif-comparison" class="flex items-center gap-3 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5 border-b border-slate-100">
                <span class="material-symbols-outlined text-sm">compare</span> AIF Comparison
              </a>
              <a href="/media" class="flex items-center gap-3 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5 border-b border-slate-100">
                <span class="material-symbols-outlined text-sm">article</span> Market Insights
              </a>
              <a href="/gift-city" class="flex items-center gap-3 text-slate-600 hover:text-brand-orange text-[11px] tracking-wide transition-colors py-1.5">
                <span class="material-symbols-outlined text-sm">location_city</span> GIFT City IFSC
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- About -->
      <a href="/about"
         class={`px-4 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive('about') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
        About
      </a>

      <!-- Partner -->
      <a href="/partner"
         class={`px-4 py-2 text-[11px] font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive('partner') ? 'text-brand-orange' : 'text-slate-500 hover:text-brand-orange'}`}>
        Partner
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <button type="button"
              class="js-open-consult bg-brand-orange text-white px-5 py-2 text-[11px] font-bold uppercase tracking-widest hover:bg-brand-orange-dark transition-all active:scale-95 hidden md:inline-flex items-center cursor-pointer">
        Consult
      </button>
      <!-- Mobile Hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden text-brand-navy p-1" aria-label="Menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Slide-down Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-100 px-6 pb-6 pt-4">
    <nav class="space-y-1">
      <a href="/" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">Home</a>
      <a href="/explore" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">Fund Explorer</a>
      <a href="/compare" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">Compare Funds</a>
      <a href="/amc" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">AMC Directory</a>
      <a href="/knowledge/aif" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">AIF Knowledge</a>
      <a href="/knowledge/pms" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">PMS Knowledge</a>
      <a href="/media" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">Insights</a>
      <a href="/about" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-slate-600 hover:text-brand-orange border-b border-slate-100">About</a>
      <a href="/partner" class="block py-3 text-[11px] font-semibold uppercase tracking-widest text-brand-orange">Partner With Us</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
