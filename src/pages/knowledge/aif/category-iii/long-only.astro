---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Long Only Funds | Category III AIF | Platizio Alternatives" currentPage="knowledge/aif">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-24">

  <!-- Breadcrumb -->
  <nav class="py-6 flex items-center gap-2 text-[11px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/knowledge/aif" class="hover:text-secondary transition-colors">AIF Knowledge</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <a href="/knowledge/aif/category-iii" class="hover:text-secondary transition-colors">Category III AIF</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">Long Only Funds</span>
  </nav>

  <!-- Hero -->
  <section class="py-14 md:py-20 border-b border-outline-variant/20 mb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-8">
        <span class="text-[10px] uppercase tracking-[0.3em] text-secondary font-bold mb-3 block">Category III AIF · SEBI AIF Regulations, 2012</span>
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="text-[10px] px-3 py-1.5 bg-primary-container text-tertiary-fixed uppercase font-bold tracking-widest">Category III</span>
          <span class="text-[10px] px-3 py-1.5 bg-surface-container text-secondary border border-outline-variant/30 uppercase font-bold tracking-widest">Long Only</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-headline text-primary-container leading-tight mb-6">
          Long Only <span class="italic font-light">Funds</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed max-w-2xl">
          Category III Long Only AIFs hold concentrated, high-conviction portfolios of listed equity securities with no short positions — generating alpha through fundamental stock selection, portfolio concentration, and long-term compounding.
        </p>
      </div>
      <div class="md:col-span-4">
        <div class="bg-primary-container p-8">
          <span class="text-[10px] uppercase font-bold tracking-widest text-tertiary-fixed/70 block mb-4">Key Criteria</span>
          <ul class="space-y-3">
            {[
              'Invests only in listed equity securities',
              'No short selling (long positions only)',
              'Derivatives used for hedging only',
              'Concentrated: typically 15–30 stocks',
              'Fund-level taxation at MMR ~42.744%',
            ].map(item => (
              <li class="text-sm text-surface font-medium flex items-start gap-2">
                <span class="material-symbols-outlined text-[14px] mt-0.5 shrink-0 text-tertiary-fixed">check_circle</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Definition -->
  <section class="mb-16 grid grid-cols-1 md:grid-cols-12 gap-10">
    <div class="md:col-span-5 bg-surface-container-low p-10">
      <h2 class="font-headline text-3xl text-primary-container mb-6">What is a Long Only AIF?</h2>
      <p class="text-sm text-on-surface-variant leading-loose">
        A Long Only Category III AIF holds exclusively long positions in listed equities. Unlike a PMS (which is a separately managed individual account), an AIF pools capital from multiple investors into a single fund vehicle. This structure enables larger position sizes, institutional-grade research, and collective access to IPOs and block deals not typically available to individual investors.
      </p>
      <div class="mt-8 pt-8 border-t border-outline-variant/30">
        <span class="text-[10px] font-bold tracking-widest uppercase text-outline">Governing Regulation</span>
        <p class="font-headline text-lg text-primary-container mt-1">SEBI AIF Regs, 2012 – Reg 3(4)(c)</p>
      </div>
    </div>
    <div class="md:col-span-7">
      <h2 class="font-headline text-3xl text-primary-container mb-6">Long Only AIF vs PMS vs Mutual Fund</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant">
              <th class="py-3 px-4 text-[10px] uppercase tracking-widest font-bold text-primary-container">Parameter</th>
              <th class="py-3 px-4 text-[10px] uppercase tracking-widest font-bold text-secondary">Cat III AIF</th>
              <th class="py-3 px-4 text-[10px] uppercase tracking-widest font-bold">PMS</th>
              <th class="py-3 px-4 text-[10px] uppercase tracking-widest font-bold">MF</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Min. Investment', '₹1 Crore', '₹50 Lakhs', '₹500'],
              ['Structure', 'Pooled fund', 'Individual account', 'Pooled fund'],
              ['Concentration', 'High (15–30 stocks)', 'High (20–30 stocks)', 'Low (50–100 stocks)'],
              ['Derivatives', 'Hedging only', 'Allowed', 'Limited'],
              ['Taxation', 'Fund-level MMR', 'Investor-level', 'Investor-level'],
              ['Reporting', 'Quarterly', 'Monthly', 'Daily NAV'],
            ].map(([param, aif, pms, mf]) => (
              <tr class="border-b border-outline-variant/20">
                <td class="py-3 px-4 font-medium text-primary-container">{param}</td>
                <td class="py-3 px-4 text-on-surface-variant">{aif}</td>
                <td class="py-3 px-4 text-on-surface-variant">{pms}</td>
                <td class="py-3 px-4 text-on-surface-variant">{mf}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Strategy -->
  <section class="mb-16">
    <h2 class="font-headline text-4xl text-primary-container mb-2">Investment Philosophy</h2>
    <div class="w-12 h-1 bg-primary-container mb-10"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        { icon: 'search', title: 'Bottom-Up Stock Selection', desc: 'Portfolio construction driven by fundamental analysis — business quality, earnings growth, competitive moat, management integrity, and valuation. Macro views play a secondary role.' },
        { icon: 'hub', title: 'High Conviction Concentration', desc: 'Typically 15–30 stocks with meaningful position sizing (3–10% per holding). Concentration is a deliberate feature — managers invest only in their best ideas, not for diversification.' },
        { icon: 'schedule', title: 'Long-Term Compounding', desc: 'Holding periods of 3–5+ years per position. The strategy benefits from earnings compounding over time rather than short-term trading. Turnover is typically low (20–40% p.a.).' },
        { icon: 'shield', title: 'Derivative Hedging', desc: 'Index put options or sector hedges may be used during periods of elevated market risk. This distinguishes Cat III Long Only from a traditional PMS, which cannot hold derivatives.' },
        { icon: 'verified', title: 'Quality Bias', desc: 'Leading managers in this space typically target companies with ROE >15%, low debt, strong cash conversion, and durable competitive advantages — the "Nifty 500 quality" universe.' },
        { icon: 'event', title: 'Opportunistic Event Participation', desc: 'Fund structure enables participation in institutional block deals, QIPs, and IPO anchor allotments — access points unavailable to individual investors or smaller managed accounts.' },
      ].map(step => (
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary-container text-3xl mb-4 block">{step.icon}</span>
          <h3 class="font-headline text-xl text-primary-container mb-3">{step.title}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Key Characteristics -->
  <section class="mb-16 bg-primary-container text-surface px-8 md:px-12 py-12 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <h2 class="font-headline text-3xl text-tertiary-fixed mb-10 relative z-10">Key <span class="italic">Characteristics at a Glance</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 relative z-10">
      {[
        { label: 'Minimum Corpus',       value: '₹20 Crore',        sub: 'per scheme' },
        { label: 'Min. Investor Ticket', value: '₹1 Crore',         sub: '₹25L for employees' },
        { label: 'Fund Structure',       value: 'Open / Closed',     sub: 'as per PPM' },
        { label: 'Short Selling',        value: 'Not Permitted',     sub: 'long positions only' },
        { label: 'Leverage',             value: 'Up to 2× NAV',      sub: 'via derivatives' },
        { label: 'Taxation',             value: 'Fund Level',        sub: 'MMR ~42.744%' },
        { label: 'Skin-in-the-Game',     value: '5% / ₹10 Cr',      sub: 'whichever is lower' },
        { label: 'Target Alpha',         value: '4–8% p.a.',         sub: 'above Nifty 50' },
      ].map(p => (
        <div class="border border-secondary/30 p-5">
          <p class="text-[10px] uppercase font-label tracking-wider text-slate-400 mb-1">{p.label}</p>
          <p class="font-headline text-xl text-tertiary-fixed leading-tight">{p.value}</p>
          <p class="text-[10px] text-slate-500 mt-1">{p.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Risk Factors -->
  <section class="mb-16">
    <h2 class="font-headline text-4xl text-primary-container mb-6">Risk Considerations</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        { icon: 'trending_down', title: 'Market Drawdown Risk', desc: 'Long-only funds have full downside exposure to equity bear markets. A 30–40% market correction results in commensurate portfolio drawdowns — there is no structural hedge.' },
        { icon: 'percent', title: 'Tax Drag at Fund Level', desc: 'Unlike PMS where gains are taxed at the investor\'s applicable rate, Cat III AIFs are taxed at MMR (~42.744%) at the fund level on all income types. This significantly reduces net returns vs PMS for long-term capital gains.' },
        { icon: 'leaderboard', title: 'Concentration Risk', desc: 'High conviction portfolios with 15–25 stocks are subject to significant single-stock risk. A governance failure or sector disruption at a top holding can materially impact portfolio NAV.' },
        { icon: 'manage_accounts', title: 'Manager Selection Risk', desc: 'Alpha generation is entirely dependent on manager skill. The Indian Cat III AIF market has several hundred funds with widely divergent performance track records.' },
      ].map(r => (
        <div class="bg-surface-container-lowest p-8 border border-outline-variant/10 flex gap-4">
          <span class="material-symbols-outlined text-primary-container text-2xl shrink-0 mt-0.5">{r.icon}</span>
          <div>
            <h3 class="font-semibold text-primary-container mb-2">{r.title}</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">{r.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-container text-white px-10 md:px-16 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 relative overflow-hidden mb-12">
    <div class="absolute top-0 right-0 w-64 h-64 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="max-w-lg relative z-10">
      <h2 class="font-headline text-3xl text-amber-100 mb-2">Explore Long Only Fund Opportunities</h2>
      <p class="text-slate-400 text-sm leading-relaxed">Access SEBI-registered Category III Long Only AIFs through Platizio Alternatives's institutional platform.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-4 relative z-10">
      <a href="/explore" class="inline-flex items-center gap-2 bg-tertiary-fixed text-on-tertiary-fixed px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity">
        Browse Funds <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
      <button type="button" class="js-open-consult inline-flex items-center gap-2 border border-white/30 text-white px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:bg-white/10 transition-colors cursor-pointer">
        Speak to Advisor
      </button>
    </div>
  </section>

  <!-- Prev / Next -->
  <div class="flex flex-col sm:flex-row gap-4">
    <a href="/knowledge/aif/category-iii" class="flex-1 border border-outline p-5 hover:border-secondary transition-colors group text-center">
      <span class="text-[10px] uppercase tracking-widest text-outline block mb-1">Back to</span>
      <span class="font-headline text-lg text-primary-container group-hover:text-secondary transition-colors">Category III AIF</span>
    </a>
    <a href="/knowledge/aif/category-iii/long-short" class="flex-1 border border-outline p-5 hover:border-secondary transition-colors group text-center">
      <span class="text-[10px] uppercase tracking-widest text-outline block mb-1">Next</span>
      <span class="font-headline text-lg text-primary-container group-hover:text-secondary transition-colors">Long Short Funds</span>
    </a>
  </div>

</div>
</BaseLayout>
