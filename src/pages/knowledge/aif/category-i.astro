---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Category I AIF | PlatAlt" currentPage="knowledge/aif">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-24">

  <!-- Breadcrumb -->
  <nav class="py-6 flex items-center gap-2 text-[11px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20">
    <a href="/knowledge/aif" class="hover:text-secondary transition-colors">AIF Knowledge</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <a href="/knowledge/aif-comparison" class="hover:text-secondary transition-colors">Category Comparison</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">Category I AIF</span>
  </nav>

  <!-- Hero -->
  <section class="py-14 md:py-20 border-b border-outline-variant/20 mb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-8">
        <span class="text-[10px] uppercase tracking-[0.3em] text-secondary font-bold mb-3 block">SEBI AIF Regulations, 2012</span>
        <div class="flex items-center gap-4 mb-4">
          <span class="text-[10px] px-3 py-1.5 bg-tertiary-fixed text-on-tertiary-fixed uppercase font-bold tracking-widest">Category I</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-headline text-primary-container leading-tight mb-6">
          Category I <span class="italic font-light">AIF</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed max-w-2xl">
          Alternative Investment Funds that invest in start-ups, early-stage ventures, social ventures, SMEs, and infrastructure sectors that the government and regulators consider socially or economically desirable — attracting specific regulatory incentives.
        </p>
      </div>
      <div class="md:col-span-4">
        <div class="bg-tertiary-fixed p-8">
          <span class="text-[10px] uppercase font-bold tracking-widest text-on-tertiary-fixed/70 block mb-4">Key Criteria</span>
          <ul class="space-y-3">
            {[
              'Socially / economically desirable sectors',
              'Start-ups and early-stage ventures',
              'SME and angel investments',
              'Infrastructure projects',
              'No leverage permitted',
            ].map(item => (
              <li class="text-sm text-on-tertiary-fixed font-medium flex items-start gap-2">
                <span class="material-symbols-outlined text-[14px] mt-0.5 shrink-0">check_circle</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Definition -->
  <section class="mb-16 grid grid-cols-1 md:grid-cols-12 gap-10">
    <div class="md:col-span-5 bg-surface-container-low p-10">
      <h2 class="font-headline text-3xl text-primary-container mb-6">SEBI Definition</h2>
      <p class="text-sm text-on-surface-variant leading-loose">
        Under Regulation 3(4)(a) of the SEBI (Alternative Investment Funds) Regulations, 2012, Category I AIF means an alternative investment fund which invests in start-up or early stage ventures or social ventures or SMEs or infrastructure or such other sectors or areas which the Government or regulators consider as socially or economically desirable and shall include venture capital funds, SME funds, social venture funds, infrastructure funds and such other alternative investment funds as may be specified.
      </p>
      <div class="mt-8 pt-8 border-t border-outline-variant/30">
        <span class="text-[10px] font-bold tracking-widest uppercase text-outline">Governing Regulation</span>
        <p class="font-headline text-lg text-primary-container mt-1">SEBI AIF Regs, 2012 – Schedule I</p>
      </div>
    </div>
    <div class="md:col-span-7">
      <h2 class="font-headline text-3xl text-primary-container mb-6">Why Category I AIFs Exist</h2>
      <p class="text-base text-on-surface-variant leading-relaxed mb-5">
        The Category I designation exists to channel institutional capital towards sectors that drive economic development but may not attract sufficient funding through conventional market mechanisms. By providing a regulated framework with potential government incentives, SEBI has encouraged the formation of specialised funds targeting India's innovation economy, rural infrastructure, and social enterprises.
      </p>
      <p class="text-base text-on-surface-variant leading-relaxed">
        For investors, Category I AIFs represent an opportunity to participate in early-stage wealth creation — venture capital, angel co-investment, and infrastructure development — within a regulated, transparent structure with defined governance obligations.
      </p>
    </div>
  </section>

  <!-- Fund Types -->
  <section class="mb-16">
    <h2 class="font-headline text-4xl text-primary-container mb-2">Fund Types</h2>
    <div class="w-12 h-1 bg-tertiary-fixed mb-10"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        {
          icon: 'rocket_launch',
          title: 'Venture Capital Funds',
          desc: 'Invest in early-stage startups and growth-stage technology companies. Typically hold concentrated positions with long horizons of 7–10 years, targeting IRRs of 20–30%.',
          href: '/knowledge/aif/category-i/venture-capital',
        },
        {
          icon: 'groups',
          title: 'Angel Funds',
          desc: 'A special sub-category permitting pooled angel investments into startups. Minimum 20 investors each contributing ₹25 Lakhs; maximum ₹10 Crore per startup investment.',
          href: '/knowledge/aif/category-i/angel',
        },
        {
          icon: 'construction',
          title: 'Infrastructure Funds',
          desc: 'Deploy capital into roads, airports, power generation, water treatment, and logistics. Offer inflation-linked, long-duration cash flows with government concession structures.',
          href: '/knowledge/aif/category-i/infrastructure',
        },
        {
          icon: 'volunteer_activism',
          title: 'Social Venture Funds',
          desc: 'Target enterprises with measurable social or environmental impact alongside financial returns. Aligned with ESG mandates, SDG goals, and impact investing frameworks.',
          href: '/knowledge/aif/category-i/social-venture',
        },
        {
          icon: 'store',
          title: 'SME Funds',
          desc: 'Provide growth capital to small and medium enterprises. Typically invest via structured equity or quasi-equity in businesses with ₹10–500 Cr revenue.',
          href: '/knowledge/aif/category-i/sme',
        },
      ].map(type => (
        <a href={type.href} class="group bg-surface-container-lowest p-8 border border-outline-variant/10 hover:border-tertiary-fixed/50 transition-all flex flex-col">
          <span class="material-symbols-outlined text-tertiary-fixed-dim text-3xl mb-4">{type.icon}</span>
          <h3 class="font-headline text-xl text-primary-container mb-3 group-hover:translate-x-1 transition-transform">{type.title}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed flex-grow">{type.desc}</p>
          <span class="mt-4 text-[10px] uppercase font-bold tracking-widest text-secondary flex items-center gap-1">
            View Funds <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Regulatory Requirements -->
  <section class="mb-16 bg-surface-container-low px-8 md:px-12 py-12 border border-outline-variant/20">
    <h2 class="font-headline text-3xl text-primary-container mb-8">Regulatory Requirements</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {[
        {
          title: 'SEBI Registration',
          points: [
            'Must register with SEBI before commencing operations',
            'Submit Form A along with due diligence and track record',
            'Registration fee: ₹5 Lakh application + ₹15 Lakh registration',
            'Annual compliance report to SEBI',
          ]
        },
        {
          title: 'Structural Requirements',
          points: [
            'Minimum corpus: ₹20 Crore per scheme',
            'Maximum 1,000 investors per scheme',
            'Each investor minimum: ₹1 Crore (₹25L for employees)',
            'Close-ended structure with minimum 3-year tenure',
          ]
        },
        {
          title: 'Disclosure Requirements',
          points: [
            'Offer document / Private Placement Memorandum mandatory',
            'Quarterly portfolio disclosure to investors',
            'Annual audit by registered Chartered Accountant',
            'Material changes require investor intimation',
          ]
        },
        {
          title: 'Operational Obligations',
          points: [
            'Appointment of Custodian for securities',
            'Separate bank account for each scheme',
            'No co-mingling of assets across schemes',
            'Investment Manager must hold 2.5% co-investment or ₹5 Crore',
          ]
        },
      ].map(section => (
        <div>
          <h3 class="font-semibold text-primary-container text-base mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-sm">gavel</span>{section.title}
          </h3>
          <ul class="space-y-2">
            {section.points.map(p => (
              <li class="flex items-start gap-2 text-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-[12px] text-tertiary-fixed-dim mt-0.5 shrink-0">check_circle</span>{p}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Tax Treatment -->
  <section class="mb-16">
    <h2 class="font-headline text-4xl text-primary-container mb-6">Tax Treatment</h2>
    <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 md:p-10">
      <div class="flex items-start gap-4 mb-6">
        <span class="material-symbols-outlined text-tertiary-fixed-dim text-3xl shrink-0">percent</span>
        <div>
          <h3 class="font-headline text-2xl text-primary-container mb-2">Pass-Through Status</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Category I AIFs enjoy pass-through tax treatment under Section 115UB of the Income Tax Act, 1961. This means income (other than business income) is not taxed at the fund level. Instead, it is deemed to be the income of the investor and taxed at the investor's applicable rate in the year of accrual.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 pt-6 border-t border-outline-variant/20">
        {[
          { label: 'Capital Gains', text: 'Taxed at investor level — LTCG at 10% (listed), STCG at 15% (listed), as per slab for unlisted.' },
          { label: 'Dividend Income', text: 'Passed through to investors and taxed at their applicable income tax slab rate.' },
          { label: 'Business Income', text: 'Exception: Business income is taxed at the fund level at Maximum Marginal Rate before pass-through.' },
        ].map(item => (
          <div class="bg-surface-container-low p-5">
            <span class="text-[10px] uppercase font-bold tracking-widest text-secondary block mb-2">{item.label}</span>
            <p class="text-sm text-on-surface-variant leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Characteristics -->
  <section class="mb-16 bg-primary-container text-surface px-8 md:px-12 py-12 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <h2 class="font-headline text-3xl text-tertiary-fixed mb-10 relative z-10">Key <span class="italic">Characteristics at a Glance</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 relative z-10">
      {[
        { label: 'Minimum Corpus',       value: '₹20 Crore',        sub: 'per scheme' },
        { label: 'Min. Investor Ticket', value: '₹1 Crore',         sub: '₹25L for employees' },
        { label: 'Max. Investors',       value: '1,000',             sub: 'per scheme' },
        { label: 'Fund Structure',       value: 'Close-Ended',       sub: 'mandatory' },
        { label: 'Minimum Tenure',       value: '3 Years',           sub: 'from final close' },
        { label: 'Leverage',             value: 'Not Permitted',     sub: 'fund level' },
        { label: 'Taxation',             value: 'Pass-Through',      sub: 'Sec. 115UB IT Act' },
        { label: 'Skin-in-the-Game',     value: '2.5% / ₹5 Cr',    sub: 'whichever is lower' },
      ].map(p => (
        <div class="border border-secondary/30 p-5">
          <p class="text-[10px] uppercase font-label tracking-wider text-slate-400 mb-1">{p.label}</p>
          <p class="font-headline text-xl text-tertiary-fixed leading-tight">{p.value}</p>
          <p class="text-[10px] text-slate-500 mt-1">{p.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-container text-white px-10 md:px-16 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="max-w-lg relative z-10">
      <h2 class="font-headline text-3xl text-amber-100 mb-2">Explore Category I Funds</h2>
      <p class="text-slate-400 text-sm leading-relaxed">Browse registered Category I AIFs available through PlatAlt's institutional platform.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-4 relative z-10">
      <a href="/explore" class="inline-flex items-center gap-2 bg-tertiary-fixed text-on-tertiary-fixed px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity">
        Browse Funds <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
      <a href="/partner" class="inline-flex items-center gap-2 border border-white/30 text-white px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:bg-white/10 transition-colors">
        Speak to Advisor
      </a>
    </div>
  </section>

  <!-- Prev / Next -->
  <div class="flex flex-col sm:flex-row gap-4 mt-12">
    <a href="/knowledge/aif-comparison" class="flex-1 border border-outline p-5 hover:border-secondary transition-colors group text-center">
      <span class="text-[10px] uppercase tracking-widest text-outline block mb-1">Previous</span>
      <span class="font-headline text-lg text-primary-container group-hover:text-secondary transition-colors">AIF Category Comparison</span>
    </a>
    <a href="/knowledge/aif/category-ii" class="flex-1 border border-outline p-5 hover:border-secondary transition-colors group text-center">
      <span class="text-[10px] uppercase tracking-widest text-outline block mb-1">Next</span>
      <span class="font-headline text-lg text-primary-container group-hover:text-secondary transition-colors">Category II AIF</span>
    </a>
  </div>

</div>

</BaseLayout>
