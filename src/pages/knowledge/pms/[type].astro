---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PMS_MANDATES, mandate, PMS_MIN_INVESTMENT } from '../../../data/pms-mandates';
import { getAllFunds } from '../../../data/funds';
import { articleNode } from '../../../data/schema';
import { seoForPmsMandate } from '../../../data/seo';

export function getStaticPaths() {
  return PMS_MANDATES.map((m) => ({ params: { type: m.key } }));
}

const { type } = Astro.params;
const m = mandate(type!);
if (!m) return Astro.redirect('/knowledge/pms');

const seo = seoForPmsMandate(m);
const others = PMS_MANDATES.filter((x) => x.key !== m.key);

// Real funds running this mandate. Most spokes have some; advisory has none in
// the current dataset, so the section renders a pointer to the explorer instead
// of an empty grid.
const funds = getAllFunds().filter((f) => f.pms_type === m.key);
---
<BaseLayout
  currentPage="knowledge/pms"
  title={seo.title}
  description={seo.description}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Knowledge', item: '/knowledge/aif' },
    { name: 'Portfolio Management Services', item: '/knowledge/pms' },
    { name: m.name },
  ]}
  schema={[
    articleNode({
      path: `/knowledge/pms/${m.key}`,
      headline: `${m.name} in India`,
      description: seo.description,
    }),
  ]}
>

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-24">

  <!-- Breadcrumb -->
  <nav class="py-6 flex items-center gap-2 text-[11px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/knowledge/pms" class="hover:text-secondary transition-colors">PMS Knowledge</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">{m.name}</span>
  </nav>

  <!-- Hero -->
  <section class="py-14 md:py-20 border-b border-outline-variant/20 mb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-8">
        <span class="text-[10px] uppercase tracking-[0.3em] text-secondary font-bold mb-3 block">Portfolio Management Services · SEBI PMS Regulations, 2020</span>
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="text-[10px] px-3 py-1.5 bg-tertiary-fixed text-on-tertiary-fixed uppercase font-bold tracking-widest">PMS</span>
          <span class="text-[10px] px-3 py-1.5 bg-surface-container text-secondary border border-outline-variant/30 uppercase font-bold tracking-widest">{m.name}</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-headline text-primary-container leading-tight mb-6">
          {m.headingLead} <span class="italic font-light">{m.headingAccent}</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed max-w-2xl">{m.summary}</p>
      </div>
      <div class="md:col-span-4">
        <div class="bg-tertiary-fixed p-8">
          <span class="text-[10px] uppercase font-bold tracking-widest text-on-tertiary-fixed/70 block mb-4">Key Characteristics</span>
          <ul class="space-y-3">
            {m.points.map((pt) => (
              <li class="text-sm text-on-tertiary-fixed font-medium flex items-start gap-2">
                <span class="material-symbols-outlined text-[14px] mt-0.5 shrink-0">check_circle</span>{pt}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it suits + the shared PMS floor -->
  <section class="mb-16 grid grid-cols-1 md:grid-cols-12 gap-10">
    <div class="md:col-span-5 bg-surface-container-low p-10">
      <h2 class="font-headline text-3xl text-primary-container mb-6">Who It Suits</h2>
      <p class="text-sm text-on-surface-variant leading-loose">{m.bestFor}</p>
    </div>
    <div class="md:col-span-7 p-10 border border-outline-variant/20">
      <h2 class="font-headline text-3xl text-primary-container mb-6">Minimum Investment</h2>
      <p class="text-sm text-on-surface-variant leading-loose">
        SEBI mandates a minimum investment of <strong class="text-primary-container">{PMS_MIN_INVESTMENT}</strong> per client
        across every PMS mandate type, including {m.name.toLowerCase()}. Unlike a pooled fund, PMS
        investors hold the underlying securities directly in their own demat account.
        For comparison, an Alternative Investment Fund requires a minimum commitment of ₹1 Crore —
        see <a href="/knowledge/pms-vs-aif-vs-mutual-fund" class="text-secondary underline hover:no-underline">PMS vs AIF vs Mutual Fund</a>.
      </p>
    </div>
  </section>

  <!-- Funds running this mandate -->
  <section class="mb-16">
    <h2 class="font-headline text-4xl text-primary-container mb-8">{m.name} Strategies</h2>
    {funds.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {funds.map((f) => (
          <a href={`/funds/${f.slug}`} class="block p-6 bg-surface-container-lowest border border-outline-variant/20 hover:border-secondary transition-colors">
            <span class="text-[10px] uppercase tracking-widest font-bold text-secondary block mb-2">{f.amc}</span>
            <h3 class="font-headline text-xl text-primary-container mb-2">{f.name}</h3>
            {f.min_investment && (
              <span class="text-xs text-on-surface-variant">Minimum {f.min_investment}</span>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-on-surface-variant leading-loose max-w-2xl">
        No {m.name.toLowerCase()} strategies are listed on the platform yet.
        Browse every registered PMS and AIF strategy in the
        <a href="/explore" class="text-secondary underline hover:no-underline"> fund explorer</a>.
      </p>
    )}
  </section>

  <!-- Sibling mandates -->
  <section>
    <h2 class="font-headline text-4xl text-primary-container mb-8">Other PMS Mandate Types</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {others.map((o) => (
        <a href={`/knowledge/pms/${o.key}`} class="block p-8 bg-surface-container-lowest border border-outline-variant/20 hover:border-secondary transition-colors">
          <h3 class="font-headline text-2xl text-primary-container mb-3">{o.name}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">{o.summary.slice(0, 150)}…</p>
        </a>
      ))}
    </div>
  </section>

</div>
</BaseLayout>
