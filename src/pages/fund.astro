---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Global Alpha Opportunities | Platizio Alternatives" currentPage="products/fund">

<div class="max-w-7xl mx-auto px-6 md:px-10 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

    <!-- Main Content -->
    <div class="lg:col-span-8 space-y-12">
      <!-- Header -->
      <section class="space-y-3">
        <div class="flex items-center gap-2 text-secondary">
          <a href="/knowledge/aif" class="text-xs uppercase tracking-[0.2em] font-label hover:text-primary-container transition-colors">AIF Funds</a>
          <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          <span class="text-xs uppercase tracking-[0.2em] font-label text-on-surface">Fund Detail</span>
        </div>
        <span class="text-[10px] font-label uppercase tracking-[0.2em] text-secondary">Institutional Grade</span>
        <h1 class="text-5xl md:text-6xl font-headline leading-tight text-primary-container">Global Alpha Opportunities</h1>
        <p class="text-on-surface-variant max-w-2xl leading-relaxed text-lg">A precision-weighted fund focused on cross-border technological disruption and sovereign debt arbitrage.</p>
      </section>

      <!-- Stats Grid -->
      <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: 'Net Asset Value', value: '$4,281.92', sub: '-0.42% Today', subClass: 'text-error', icon: 'arrow_downward' },
          { label: 'YTD Return', value: '+18.4%', sub: 'Top Decile', subClass: 'text-on-tertiary-container', icon: 'star' },
          { label: 'AUM', value: '$2.3B', sub: 'Across 12 vintages', subClass: 'text-on-surface-variant', icon: null },
          { label: 'Min. Investment', value: '₹1 Cr', sub: 'Category II AIF', subClass: 'text-on-surface-variant', icon: null },
        ].map(s => (
          <div class="bg-surface-container-lowest p-5 space-y-1 border border-outline-variant/10">
            <span class="text-[10px] font-label uppercase tracking-widest text-outline">{s.label}</span>
            <div class="text-2xl md:text-3xl font-headline text-primary-container">{s.value}</div>
            <div class={`text-[10px] font-medium flex items-center gap-1 ${s.subClass}`}>
              {s.icon && <span class="material-symbols-outlined text-xs" style="font-variation-settings:'FILL' 1,'wght' 300,'GRAD' 0,'opsz' 24">{s.icon}</span>}
              {s.sub}
            </div>
          </div>
        ))}
      </section>

      <!-- Performance Chart -->
      <section class="space-y-6">
        <div class="flex justify-between items-end">
          <h2 class="text-2xl font-headline italic text-primary-container">Performance</h2>
          <div class="flex gap-2">
            <button class="px-3 py-1 bg-primary-container text-amber-100 text-[10px] font-label">1Y</button>
            <button class="px-3 py-1 bg-surface-container text-outline text-[10px] font-label hover:bg-surface-container-high transition-colors">5Y</button>
            <button class="px-3 py-1 bg-surface-container text-outline text-[10px] font-label hover:bg-surface-container-high transition-colors">MAX</button>
          </div>
        </div>
        <div class="h-72 w-full bg-surface-container-low relative overflow-hidden">
          <div class="absolute inset-0 opacity-5 flex items-center justify-center">
            <span class="text-[120px] font-serif italic select-none">Alpha</span>
          </div>
          <svg class="w-full h-full" viewBox="0 0 400 150" preserveAspectRatio="none">
            <path d="M0,130 C40,120 80,140 120,100 C160,60 200,80 240,40 C280,0 320,50 400,20" fill="none" stroke="#0f1c2c" stroke-width="2"/>
            <path d="M0,130 C40,120 80,140 120,100 C160,60 200,80 240,40 C280,0 320,50 400,20 V150 H0 Z" class="fill-primary-container/5"/>
            <circle cx="240" cy="40" r="4" class="fill-tertiary-fixed"/>
          </svg>
          <div class="absolute top-4 right-4 bg-surface-container-lowest/80 backdrop-blur px-3 py-2 text-[10px] font-label border-l-2 border-amber-200">
            <span class="text-outline uppercase block">Peak Valuation</span>
            <span class="text-primary-container font-bold">Aug 2023</span>
          </div>
        </div>
      </section>

      <!-- Strategy & Philosophy -->
      <section class="space-y-6">
        <h2 class="text-2xl font-headline italic text-primary-container">Strategy & Philosophy</h2>
        <div class="relative bg-primary-container text-on-primary p-8 space-y-4">
          <span class="material-symbols-outlined text-amber-200 text-4xl">format_quote</span>
          <p class="font-headline text-xl leading-relaxed italic">
            "We do not seek to follow the market; we seek to understand the structural inefficiencies that the market ignores. Our edge lies in the patience of sovereign capital."
          </p>
          <div class="flex items-center gap-4 pt-4 border-t border-white/10">
            <div class="w-12 h-12 overflow-hidden border-2 border-amber-200">
              <img alt="Fund Manager Profile" class="w-full h-full object-cover"
                   src="https://lh3.googleusercontent.com/aida-public/AB6AXuDl3yx5uWp9gVGoFIczc7w05z4QUiaoMuejHJ5BSV-csE9E5UXPZkgtbfPtsnV94Sd9i3Ev59RTIWqW4HdcPvH5PlOZ4tAXAenBIown_FCCDhqkuSilB664aZA0mqneu-iK0F8z7SVPyvp38uQ3mgji5n-LGzthCJNzy9cumzqKCn7WZLgbmRo38vxHZsgBegLpoCCV4Ot29bDPOHlNZ08OwxRIpW0jFAD65gwqKQxHGhBoPgYbjSZ3dxbaJqasgVWqnMuMbyhBPeU" />
            </div>
            <div>
              <span class="block font-headline text-amber-100">Julian Vane-Tempest</span>
              <span class="block text-[10px] uppercase tracking-widest text-white/60">Chief Investment Officer</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Asset Allocation -->
      <section class="space-y-6">
        <h2 class="text-2xl font-headline italic text-primary-container">Asset Allocation</h2>
        <div class="space-y-5">
          {[
            { icon: 'trending_up', label: 'Equities', pct: '62%', width: 'w-[62%]' },
            { icon: 'account_balance', label: 'Fixed Income', pct: '28%', width: 'w-[28%]' },
            { icon: 'diamond', label: 'Alternatives', pct: '10%', width: 'w-[10%]' },
          ].map(a => (
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 w-40 shrink-0">
                <span class="material-symbols-outlined text-secondary">{a.icon}</span>
                <span class="text-sm font-medium">{a.label}</span>
              </div>
              <div class="flex-1 flex items-center gap-4">
                <div class="flex-1 h-1 bg-surface-container-high">
                  <div class={`h-full bg-primary-container ${a.width}`}></div>
                </div>
                <span class="text-sm font-headline w-12 text-right">{a.pct}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-4 space-y-6">
      <div class="sticky top-24 space-y-6">
        <div class="bg-surface-container-low p-8 text-center space-y-4">
          <h3 class="text-2xl font-headline text-primary-container">Exclusive Insight Required?</h3>
          <p class="text-sm text-on-surface-variant">Schedule a private briefing with our advisory team to discuss risk profiles and entry windows.</p>
          <button type="button" class="js-open-consult block w-full py-4 bg-primary-container text-on-primary font-label text-xs uppercase tracking-[0.2em] hover:bg-slate-800 transition-colors text-center">
            Consult Advisor
          </button>
          <a class="block text-[10px] uppercase tracking-widest text-outline border-b border-transparent hover:border-outline inline-block pt-2" href="#">Download Prospectus (PDF)</a>
        </div>

        <!-- Key Details -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 p-6 space-y-4">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-primary-container">Fund Details</h4>
          {[
            { label: 'Category', value: 'Category II AIF' },
            { label: 'Structure', value: 'Close-ended Trust' },
            { label: 'Tenure', value: '7 Years' },
            { label: 'Benchmark', value: 'Nifty 500' },
            { label: 'Exit Load', value: '2% (yr 1-3)' },
            { label: 'Manager Fee', value: '2% + 20% Carry' },
          ].map(d => (
            <div class="flex justify-between text-sm border-b border-outline-variant/10 pb-3">
              <span class="text-on-surface-variant font-light">{d.label}</span>
              <span class="font-medium">{d.value}</span>
            </div>
          ))}
        </div>

        <!-- Compare Link -->
        <a href="/compare" class="flex items-center gap-3 border border-outline p-4 hover:border-secondary transition-colors group">
          <span class="material-symbols-outlined text-secondary">compare_arrows</span>
          <span class="text-xs font-bold uppercase tracking-widest group-hover:text-secondary transition-colors">Add to Comparison</span>
        </a>
      </div>
    </div>

  </div>
</div>

</BaseLayout>
