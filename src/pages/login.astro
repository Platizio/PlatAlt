---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Institutional Login | The Sovereign Ledger" currentPage="login" noFooter={true}>

<!-- Subtle Background Watermark -->
<div class="fixed inset-0 z-0 flex items-center justify-center overflow-hidden pointer-events-none">
  <div class="text-[15rem] leading-none rotate-[-12deg] whitespace-nowrap select-none opacity-[0.03] font-serif italic text-primary-container">
    Sovereign Ledger Sovereign Ledger
  </div>
</div>

<!-- Decorative Corners -->
<div class="fixed top-0 right-0 p-8 opacity-20 hidden md:block pointer-events-none">
  <div class="border-t border-r border-primary-container w-24 h-24"></div>
</div>
<div class="fixed bottom-0 left-0 p-8 opacity-20 hidden md:block pointer-events-none">
  <div class="border-b border-l border-primary-container w-24 h-24"></div>
</div>

<!-- Login Form -->
<div class="relative z-10 min-h-[calc(100vh-72px)] flex items-center justify-center px-6 py-16">
  <div class="w-full max-w-md">
    <!-- Branding Header -->
    <div class="text-center mb-16">
      <div class="mb-4 inline-flex items-center justify-center p-4 bg-primary-container text-tertiary-fixed">
        <span class="material-symbols-outlined text-3xl" style="font-variation-settings:'FILL' 1,'wght' 300,'GRAD' 0,'opsz' 24">shield_person</span>
      </div>
      <h1 class="font-headline italic text-4xl text-primary-container tracking-tight">Sovereign Ledger</h1>
      <p class="text-secondary mt-3 text-xs uppercase tracking-[0.2em]">Institutional Wealth Portal</p>
    </div>

    <!-- Login Form -->
    <form class="space-y-8" method="POST">
      <div class="space-y-6">
        <div class="relative group">
          <label class="font-label text-[10px] uppercase tracking-widest text-secondary block mb-1" for="identifier">Entity Identifier</label>
          <input class="w-full bg-transparent border-0 border-b border-outline-variant py-3 px-0 focus:ring-0 focus:border-tertiary-fixed-dim text-on-surface transition-all placeholder:text-outline-variant/50"
                 id="identifier" name="identifier" placeholder="Ex: SL-9928-ALPHA" type="text" />
        </div>
        <div class="relative group">
          <label class="font-label text-[10px] uppercase tracking-widest text-secondary block mb-1" for="credential">Security Credential</label>
          <div class="relative">
            <input class="w-full bg-transparent border-0 border-b border-outline-variant py-3 px-0 focus:ring-0 focus:border-tertiary-fixed-dim text-on-surface transition-all placeholder:text-outline-variant/50"
                   id="credential" name="credential" placeholder="••••••••••••" type="password" />
            <button type="button" class="absolute right-0 top-1/2 -translate-y-1/2 text-outline-variant hover:text-secondary transition-colors" aria-label="Toggle password visibility">
              <span class="material-symbols-outlined text-sm">visibility</span>
            </button>
          </div>
        </div>
      </div>

      <!-- MFA Indicator -->
      <div class="flex items-start gap-3 p-4 bg-surface-container-low">
        <span class="material-symbols-outlined text-secondary text-sm">verified_user</span>
        <p class="text-[11px] leading-relaxed text-secondary font-medium">
          Encrypted session. Two-factor authentication will be required upon identification.
        </p>
      </div>

      <!-- Submit -->
      <button class="w-full bg-primary-container text-on-primary py-4 font-label text-sm uppercase tracking-widest hover:bg-slate-800 transition-all flex items-center justify-center gap-2 group" type="submit">
        Begin Verification
        <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </button>
    </form>

    <!-- Footer Links -->
    <div class="mt-12 flex justify-between items-center text-[10px] uppercase tracking-widest font-label">
      <a class="text-secondary hover:text-on-tertiary-container transition-colors py-2 border-b border-transparent hover:border-on-tertiary-container" href="/partner">Request Access</a>
      <a class="text-secondary hover:text-on-tertiary-container transition-colors py-2 border-b border-transparent hover:border-on-tertiary-container" href="#">Recovery Terminal</a>
    </div>
  </div>
</div>

</BaseLayout>
