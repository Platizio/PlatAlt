---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="The Sovereign Ledger | AlternaVest Capital" currentPage="home">

<!-- Hero Section -->
<section class="relative min-h-[91vh] flex items-center overflow-hidden bg-primary-container">
  <div class="absolute inset-0 opacity-40">
    <img class="w-full h-full object-cover" alt="Modern architectural glass building reflecting a clear blue sky" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD8uDef_MfPsZRmcftAnNyxUtAhILTxX0PwtHCNDvqYVzdQF2b6JGFaFAgbXLQYszoOnWQnUBXAdCQqmk9Sk2blfjr3kDbxfxOH1MPjQYxwzYenTSMmgalEnqkXMWZlP9W2y2UXbhZjDzahiG6XGxrfgvPKeGO0pfJuGLZv6Kyy-DmH9cU9hSSLFbSmFo0qbY0f6Cjb59sz-MMxS8pL09kHtPrOPIXM0MRjhjslqxqSDj0MxSLDCDPEbUmj-4FGL-dNqxhab_xSri0" />
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary-container via-primary-container/80 to-transparent"></div>
  <div class="container mx-auto px-6 lg:px-10 relative z-10 grid md:grid-cols-12 gap-8 py-20">
    <div class="md:col-span-8 lg:col-span-7">
      <p class="text-amber-200/70 text-[11px] font-bold uppercase tracking-[0.3em] mb-6">Institutional Alternative Investments</p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl text-white font-serif leading-[1.05] mb-8 font-light italic">
        Curated PMS and<br/>
        <span class="text-tertiary-fixed not-italic font-semibold">AIF Discovery</span>
      </h1>
      <p class="text-slate-300 text-lg md:text-xl max-w-xl mb-12 font-light leading-relaxed">
        Access exclusive alternative investment frameworks designed for the discerning capital allocator. Precision, transparency, and institutional-grade rigor.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/explore" class="bg-tertiary-fixed text-on-tertiary-fixed px-10 py-4 font-bold text-xs uppercase tracking-[0.2em] hover:brightness-110 transition-all flex items-center gap-2">
          Explore Products <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
        <button type="button" class="js-open-consult border border-slate-500 text-white px-10 py-4 font-bold text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all">
          Book a Consultation
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Ticker Strip -->
<section class="bg-surface-container-low border-y border-outline-variant/10 py-5 overflow-hidden">
  <div class="flex whitespace-nowrap ticker-scroll items-center">
    <div class="flex items-center gap-12 px-6">
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Renaissance Alpha Fund +18.4%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Strategic Growth PMS +12.1%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Global Quant AIF +4.8%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Sovereign Yield Fund +9.2%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Blume VC AIF +22.3%</span>
    </div>
    <div class="flex items-center gap-12 px-6" aria-hidden="true">
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Renaissance Alpha Fund +18.4%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Strategic Growth PMS +12.1%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Global Quant AIF +4.8%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Sovereign Yield Fund +9.2%</span>
      <span class="text-outline mx-4">|</span>
      <span class="flex items-center gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase"><span class="w-2 h-2 rounded-full bg-green-500"></span> Blume VC AIF +22.3%</span>
    </div>
  </div>
</section>

<!-- AIF Category Quick Links -->
<section class="py-16 px-6 lg:px-10 bg-surface-container-low">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-secondary mb-3 block">Explore by Category</span>
        <h2 class="text-3xl md:text-4xl">AIF <span class="italic">Categories</span></h2>
      </div>
      <a href="/knowledge/aif" class="text-[11px] font-bold uppercase tracking-widest text-secondary hover:text-primary flex items-center gap-1 transition-colors">
        View Knowledge Center <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[
        { label: 'Venture Capital', href: '/funds/venture-capital', icon: 'rocket_launch' },
        { label: 'Private Equity', href: '/funds/private-equity', icon: 'account_balance' },
        { label: 'Real Estate', href: '/funds/real-estate', icon: 'domain' },
        { label: 'Debt Funds', href: '/funds/debt', icon: 'payments' },
        { label: 'Infrastructure', href: '/funds/infrastructure', icon: 'construction' },
        { label: 'Long Short', href: '/funds/long-short', icon: 'trending_up' },
        { label: 'Multi Strategy', href: '/funds/multi-strategy', icon: 'hub' },
        { label: 'Angel Funds', href: '/funds/angel', icon: 'star' },
        { label: 'Structured Credit', href: '/funds/structured-credit', icon: 'credit_card' },
        { label: 'SME Funds', href: '/funds/sme', icon: 'storefront' },
      ].map(cat => (
        <a href={cat.href} class="bg-surface-container-lowest p-5 flex flex-col items-start gap-3 hover:bg-white hover:shadow-md transition-all group border border-transparent hover:border-outline-variant/20">
          <span class="material-symbols-outlined text-secondary group-hover:text-primary-container transition-colors">{cat.icon}</span>
          <span class="text-xs font-bold uppercase tracking-wide text-on-surface group-hover:translate-x-0.5 transition-transform">{cat.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Investment Journey (Asymmetric Layout) -->
<section class="py-24 px-6 lg:px-10">
  <div class="container mx-auto max-w-7xl grid md:grid-cols-12 gap-16 items-start">
    <div class="md:col-span-5 md:sticky top-28">
      <h2 class="text-4xl md:text-6xl mb-6 leading-tight font-headline">Your Investment<br/><span class="italic text-secondary">Journey</span></h2>
      <p class="text-on-surface-variant font-light leading-relaxed max-w-sm mb-8">
        We guide you through the complexities of alternative asset classes with a structured, high-touch approach tailored for HNIs.
      </p>
      <div class="h-[1px] w-24 bg-tertiary-fixed"></div>
    </div>
    <div class="md:col-span-7 space-y-12">
      {[
        { num: '01', icon: 'phone', title: 'Discovery Session', text: 'A personal consultation to map your risk appetite and long-term liquidity requirements within the Sovereign ecosystem.' },
        { num: '02', icon: 'search', title: 'Curated Selection', text: 'Leverage our proprietary vetting process to filter through thousands of PMS and AIF strategies to find the top 1%.' },
        { num: '03', icon: 'account_balance', title: 'Portfolio Balancing', text: 'Implementation of selected strategies with continuous monitoring and dynamic rebalancing across market cycles.' },
      ].map(step => (
        <div class="flex gap-8 group">
          <div class="flex-shrink-0 w-16 h-16 bg-surface-container-high flex items-center justify-center transition-colors group-hover:bg-primary-container group-hover:text-tertiary-fixed">
            <span class="material-symbols-outlined text-3xl">{step.icon}</span>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-2 uppercase tracking-wide">{step.num}. {step.title}</h3>
            <p class="text-on-surface-variant font-light leading-relaxed">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Research & Insights -->
<section class="py-24 bg-surface-container-low">
  <div class="container mx-auto px-6 lg:px-10 max-w-7xl">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-secondary mb-4 block">Institutional Intelligence</span>
        <h2 class="text-4xl md:text-5xl font-headline">Research & <span class="italic">Insights</span></h2>
      </div>
      <div class="flex bg-surface-container p-1 gap-1">
        <button class="px-5 py-2 text-xs font-bold uppercase tracking-widest bg-white shadow-sm">Articles</button>
        <button class="px-5 py-2 text-xs font-bold uppercase tracking-widest hover:bg-white/50 transition-all">Videos</button>
        <button class="px-5 py-2 text-xs font-bold uppercase tracking-widest hover:bg-white/50 transition-all">Outlook</button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Featured Article -->
      <div class="md:col-span-2 relative h-[480px] group overflow-hidden bg-primary-container">
        <img class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
             alt="Chess king piece representing strategic investment"
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmyOK5CIXMjb6n3T_afGGLfroTJTihU9ficqS4cKdjdDVV3EHARgW8fGsNjW1pSH6V04nwQCzEHYr3g7HMnhOp64LhdfHt_7vXqxts9fd4yrnhpEjwZhtSZmm7uL9BSwO4HTpATsGDu8zJBNT0ExM8mqrrSyRjsF1AltPXwCHilxNXtceAa259u7568NQi9ZRt7n4gkCWE-Uc2UeA9W6SlKXZUg4M02OU9bMJEadV1SdrgjjwRixSqT57em7lSBAtgVu4upLWTAVY" />
        <div class="absolute inset-0 bg-gradient-to-t from-primary-container via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-10">
          <span class="bg-tertiary-fixed text-on-tertiary-fixed text-[10px] font-bold uppercase tracking-widest px-3 py-1 mb-4 inline-block">Market Outlook</span>
          <h3 class="text-3xl md:text-4xl text-white font-serif mb-4">Navigating the 2024 Liquidity Super-Cycle</h3>
          <p class="text-slate-300 max-w-md font-light mb-6">Expert analysis on how private equity and alternative debt are responding to shifting central bank policies.</p>
          <a class="text-white text-xs font-bold uppercase tracking-widest flex items-center gap-2 group/link" href="/knowledge/article">
            Read Full Thesis <span class="material-symbols-outlined text-sm group-hover/link:translate-x-1 transition-transform">arrow_right_alt</span>
          </a>
        </div>
      </div>
      <!-- Secondary Items -->
      <div class="space-y-6">
        <div class="bg-white p-8 h-[228px] flex flex-col justify-between hover:shadow-xl transition-shadow">
          <div>
            <span class="text-secondary text-[10px] font-bold uppercase tracking-widest">Video Analysis</span>
            <h4 class="text-xl font-bold mt-4 font-headline leading-tight">The Rise of Multi-Strategy AIFs in Volatile Markets</h4>
          </div>
          <a href="/media" class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest hover:text-secondary transition-colors">
            <span class="material-symbols-outlined p-2 border border-outline rounded-full text-sm">play_arrow</span> Watch Now
          </a>
        </div>
        <div class="bg-primary-container text-white p-8 h-[228px] flex flex-col justify-between hover:bg-slate-900 transition-colors">
          <div>
            <span class="text-tertiary-fixed text-[10px] font-bold uppercase tracking-widest">Whitepaper</span>
            <h4 class="text-xl font-bold mt-4 font-headline leading-tight">Tax-Efficient Portfolio Structuring for Ultra HNIs</h4>
          </div>
          <a href="/knowledge/aif" class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest hover:text-tertiary-fixed transition-colors">
            <span class="material-symbols-outlined text-sm">download</span> Download PDF
          </a>
        </div>
      </div>
    </div>
    <div class="mt-12 text-center">
      <a href="/media" class="inline-flex items-center gap-2 border border-outline text-[11px] font-bold uppercase tracking-widest px-8 py-3 hover:bg-primary-container hover:text-white hover:border-primary-container transition-all">
        View All Insights <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

<!-- Final CTA Band -->
<section class="py-24 relative overflow-hidden bg-slate-950">
  <div class="absolute inset-0 opacity-20">
    <img class="w-full h-full object-cover" alt="Luxury office lounge" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAqZfIxW5sCmCknsrDe8ycd30WoLTyruF8FaKqP8-YM5_YwJkswd_P4fktzSZyfzHucO7LUixCzLL1CAZy1f1TYcSaYwhPaLMAkCYTb7biEpdnW1OREFOXtYvV-ykaqJVoTKKvJsAGT8Uug8qKXRFCZtzxWCNUZxFfDIsH98AssNkmCa2W4mQFlkr9S4Vu8P8S4w7FoVSSnglIW9bJnmZfPlCnoGjiaTuQNuTAkJwQ04sFS-zbZkFfPRtGdcYUj_q8j_Z4pIe6TeUw" />
  </div>
  <div class="container mx-auto px-6 relative z-10 text-center max-w-4xl">
    <h2 class="text-4xl md:text-6xl text-white mb-8 font-serif italic">Elevate your capital's <span class="not-italic text-tertiary-fixed">potential.</span></h2>
    <p class="text-slate-400 max-w-2xl mx-auto mb-12 text-lg font-light leading-relaxed">
      Our private advisors are ready to discuss bespoke opportunities that align with your unique legacy and growth objectives.
    </p>
    <div class="flex flex-col md:flex-row justify-center gap-6">
      <button type="button" class="js-open-consult bg-white text-primary-container px-12 py-5 font-bold text-xs uppercase tracking-[0.2em] hover:bg-tertiary-fixed transition-all">
        Book a Consultation
      </button>
      <a href="/explore" class="border border-white/30 text-white px-12 py-5 font-bold text-xs uppercase tracking-[0.2em] hover:bg-white/5 transition-all">
        View Fund Explorer
      </a>
    </div>
  </div>
</section>

</BaseLayout>
