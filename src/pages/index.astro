---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import heroFacade from '../assets/hero-facade.jpg';
import { getAllFunds } from '../data/funds';
import { termOf } from '../data/aif-taxonomy';

// Ticker is driven off the real SEBI/APMI dataset so it cannot go stale.
// Names and categories only - the dataset carries no return figures.
const CAT_SHORT: Record<string, string> = {
  PMS: 'PMS',
  AIF_CAT1: 'AIF Cat I',
  AIF_CAT2: 'AIF Cat II',
  AIF_CAT3: 'AIF Cat III',
  GIFT_CITY: 'GIFT City',
};
const tickerFunds = getAllFunds().map((f) => ({
  name: f.name,
  cat: CAT_SHORT[f.site_type] ?? f.site_type,
  href: `/funds/${f.slug}`,
}));

// Uploads playlist of the Platizio Alternatives YouTube channel
// (channel UCriQiBtwCdiNAvNdJBqYcyw -> uploads playlist UU...): always the newest
// video, so publishing a video needs no code change.
const UPLOADS_PLAYLIST = 'UUriQiBtwCdiNAvNdJBqYcyw';

const insightLinks = [
  { tag: 'AIF', title: 'AIF Knowledge Centre - Categories I, II & III', href: '/knowledge/aif' },
  { tag: 'PMS', title: 'Portfolio Management Services explained', href: '/knowledge/pms' },
  { tag: 'Comparison', title: 'AIF category comparison', href: '/knowledge/aif-comparison' },
  { tag: 'GIFT IFSC', title: 'Investing through GIFT City', href: '/gift-city' },
];
---
<BaseLayout currentPage="home">

<!-- Hero Section -->
<section class="relative min-h-[91vh] flex items-center overflow-hidden bg-primary-container">
  <!--
    Retuned for the removal of the hero photograph. The old stack was
    navy field -> photo at opacity-40 -> left-to-right navy-to-transparent scrim,
    so the right-hand third of the hero was carried entirely by the picture.
    With the photo gone that scrim resolves to flat navy, so the depth is rebuilt
    from brand tokens: a slate bloom where the building used to catch light, a
    warm amber counterlight off the right edge, and the original scrim kept in
    front of both so the headline sits on solid navy exactly as before.
  -->
  <!--
    Hero photograph. Self-hosted and served through astro:assets, so it ships as
    AVIF/WebP with intrinsic dimensions. At 2880x1620 it is 2x the ~1440x819 box,
    which is what the previous hero image could never be — that one was a 512px
    source stretched 2.81x.

    It is the LCP element, so it loads eagerly at high priority rather than lazily.
    Decorative, hence alt="".

    The scrim in front of it is the original left-to-right navy wash: the headline
    still sits on solid navy, and the picture carries the right-hand third.
  -->
  <div class="absolute inset-0">
    <Picture src={heroFacade} alt="" widths={[768, 1280, 1920, 2880]} sizes="100vw"
             formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async"
             class="w-full h-full object-cover" />
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary-container via-primary-container/85 to-primary-container/25"></div>
  <!--
    The scrim above is horizontal, which is enough on desktop where the copy
    occupies the left seven columns. At mobile the copy spans the full width and
    runs over the brighter facade panels, so small screens get an additional flat
    veil rather than relying on the gradient alone.
  -->
  <div class="absolute inset-0 bg-primary-container/55 md:hidden" aria-hidden="true"></div>
  <div class="container mx-auto px-6 lg:px-10 relative z-10 grid md:grid-cols-12 gap-8 py-20">
    <div class="md:col-span-8 lg:col-span-7">
      <p class="text-amber-200/70 text-[11px] font-bold uppercase tracking-[0.3em] mb-6">Institutional Alternative Investments</p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl text-white font-serif leading-[1.05] mb-8 font-light italic">
        Curated PMS and<br/>
        <span class="text-tertiary-fixed not-italic font-semibold">AIF Discovery</span>
      </h1>
      <p class="text-slate-300 text-lg md:text-xl max-w-xl mb-12 font-light leading-relaxed">
        Access exclusive alternative investment frameworks designed for the discerning capital allocator. Precision, transparency, and institutional-grade rigor.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/explore" class="bg-tertiary-fixed text-on-tertiary-fixed px-10 py-4 font-bold text-xs uppercase tracking-[0.2em] hover:brightness-110 transition-all flex items-center gap-2">
          Explore Products <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
        <button type="button" class="js-open-consult border border-slate-500 text-white px-10 py-4 font-bold text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all">
          Book a Consultation
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Ticker Strip -->
<section class="bg-surface-container-low border-y border-outline-variant/10 py-5 overflow-hidden">
  <div class="flex whitespace-nowrap ticker-scroll items-center">
    {[0, 1].map((track) => (
      <div class="flex items-center px-6" aria-hidden={track === 1 ? 'true' : undefined}>
        {tickerFunds.map((f) => (
          <span class="flex items-center">
            <a href={f.href} class="flex items-baseline gap-2 text-primary-container font-bold text-sm tracking-tighter uppercase hover:text-secondary transition-colors">
              {f.name}
              <span class="text-secondary font-medium text-[11px] normal-case tracking-normal">{f.cat}</span>
            </a>
            <span class="block w-[2px] h-6 bg-outline/70 mx-6" aria-hidden="true"></span>
          </span>
        ))}
      </div>
    ))}
  </div>
</section>

<!-- AIF Category Quick Links -->
<section class="py-16 px-6 lg:px-10 bg-surface-container-low">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-secondary mb-3 block">Explore by Category</span>
        <h2 class="text-3xl md:text-4xl">AIF <span class="italic">Categories</span></h2>
      </div>
      <a href="/knowledge/aif" class="text-[11px] font-bold uppercase tracking-widest text-secondary hover:text-primary flex items-center gap-1 transition-colors">
        View Knowledge Center <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {/*
        These point at the /knowledge pages rather than /funds/<strategy>.
        The homepage is the strongest internal link source on the site, and
        /funds/<strategy> canonicalises into /knowledge — linking sitewide into
        a canonicalised URL contradicts the canonical it carries. Paths come
        from the taxonomy module so a renamed sub-category cannot strand them.
      */}
      {[
        { sub: 'venture-capital', label: 'Venture Capital', icon: 'rocket_launch' },
        { sub: 'private-equity', label: 'Private Equity', icon: 'account_balance' },
        { sub: 'real-estate', label: 'Real Estate', icon: 'domain' },
        { sub: 'debt', label: 'Debt Funds', icon: 'payments' },
        { sub: 'infrastructure', label: 'Infrastructure', icon: 'construction' },
        { sub: 'long-short', label: 'Long Short', icon: 'swap_vert' },
        { sub: 'multi-strategy', label: 'Multi Strategy', icon: 'hub' },
        { sub: 'angel', label: 'Angel Funds', icon: 'star' },
        { sub: 'sme', label: 'SME Funds', icon: 'storefront' },
        { sub: 'distressed-assets', label: 'Distressed Assets', icon: 'credit_card' },
      ].map(c => ({ ...c, href: termOf(c.sub)?.path ?? '/knowledge/aif' })).map(cat => (
        <a href={cat.href} class="bg-surface-container-lowest p-5 flex flex-col items-center text-center gap-3 hover:bg-white hover:shadow-md transition-all group border border-transparent hover:border-outline-variant/20">
          <span class="material-symbols-outlined text-secondary group-hover:text-primary-container transition-colors">{cat.icon}</span>
          <span class="text-sm font-bold uppercase tracking-wide text-on-surface">{cat.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Investment Journey (Asymmetric Layout) -->
<section class="py-24 px-6 lg:px-10">
  <div class="container mx-auto max-w-7xl grid md:grid-cols-12 gap-16 items-start">
    <div class="md:col-span-5 md:sticky top-28">
      <h2 class="text-4xl md:text-6xl mb-6 leading-tight font-headline">Your Investment<br/><span class="italic text-secondary">Journey</span></h2>
      <p class="text-on-surface-variant font-light leading-relaxed max-w-sm mb-8">
        We guide you through the complexities of alternative investments with a structured, high-touch approach tailored for HNIs.
      </p>
      <div class="h-[1px] w-24 bg-tertiary-fixed"></div>
    </div>
    <div class="md:col-span-7 space-y-12">
      {[
        { num: '01', icon: 'phone', title: 'Discovery Session', text: 'A personal consultation to map your risk appetite and long-term liquidity requirements across alternative investments.' },
        { num: '02', icon: 'search', title: 'Curated Selection', text: 'Leverage our proprietary vetting process to filter through thousands of PMS and AIF strategies to find the top 1%.' },
        { num: '03', icon: 'balance', title: 'Portfolio Balancing', text: 'Implementation of selected strategies with continuous monitoring and dynamic rebalancing across market cycles.' },
      ].map(step => (
        <div class="flex gap-8 group">
          <div class="flex-shrink-0 w-16 h-16 bg-surface-container-high flex items-center justify-center transition-colors group-hover:bg-primary-container group-hover:text-tertiary-fixed">
            <span class="material-symbols-outlined text-3xl">{step.icon}</span>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-2 uppercase tracking-wide">{step.num}. {step.title}</h3>
            <p class="text-on-surface-variant font-light leading-relaxed">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Media Outlook -->
<section class="py-24 bg-surface-container-low">
  <div class="container mx-auto px-6 lg:px-10 max-w-7xl">
    <div class="text-center mb-14">
      <h2 class="text-4xl md:text-5xl font-headline">Media <span class="italic">outlook</span></h2>
      <div class="w-20 h-[1px] bg-tertiary-fixed-dim mx-auto mt-6"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-8">
        <div class="relative w-full aspect-video bg-primary-container">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS_PLAYLIST}`}
            title="Platizio Alternatives - latest videos"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
      </div>
      <div class="md:col-span-4 flex flex-col">
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-secondary mb-5 block">From the knowledge centre</span>
        <div class="flex flex-col border-t border-outline-variant/40">
          {insightLinks.map((item) => (
            <a href={item.href} class="group flex items-start justify-between gap-4 py-4 border-b border-outline-variant/40 hover:bg-white/60 transition-colors">
              <span>
                <span class="block text-[10px] font-bold uppercase tracking-widest text-secondary mb-1">{item.tag}</span>
                <span class="block text-sm font-bold leading-snug text-on-surface">{item.title}</span>
              </span>
              <span class="material-symbols-outlined text-base text-secondary group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </a>
          ))}
        </div>
        <a href="/media" class="mt-6 inline-flex items-center gap-2 border border-outline text-[11px] font-bold uppercase tracking-widest px-6 py-3 hover:bg-primary-container hover:text-white hover:border-primary-container transition-all w-max">
          All market insights <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA Band -->
<section class="py-24 relative overflow-hidden bg-slate-950">
  <div class="container mx-auto px-6 relative z-10 text-center max-w-4xl">
    <h2 class="text-4xl md:text-6xl text-white mb-8 font-serif italic">Invest with <span class="not-italic text-tertiary-fixed">Greater Clarity</span></h2>
    <p class="text-slate-400 max-w-2xl mx-auto mb-12 text-lg font-light leading-relaxed">
      Speak with our investment experts to understand opportunities aligned with your financial goals, risk profile, and investment preferences.
    </p>
    <div class="flex flex-col md:flex-row justify-center gap-6">
      <button type="button" class="js-open-consult bg-white text-primary-container px-12 py-5 font-bold text-xs uppercase tracking-[0.2em] hover:bg-tertiary-fixed transition-all">
        Book a Consultation
      </button>
      <a href="/explore" class="border border-white/30 text-white px-12 py-5 font-bold text-xs uppercase tracking-[0.2em] hover:bg-white/5 transition-all">
        View Fund Explorer
      </a>
    </div>
  </div>
</section>

</BaseLayout>
