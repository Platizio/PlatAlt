    metric: 'Return (3Y)', value: '16.8% p.a.',
    aum: 3800, aumDisplay: '₹3,800 Cr', inception: 2012,
    href: '/funds/kotak-advisory-pms',
  },
  /* ── AIF CAT I ────────────────────────────────────────── */
