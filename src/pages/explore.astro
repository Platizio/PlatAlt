---
import BaseLayout from '../layouts/BaseLayout.astro';
import { exploreCards, uniqueAMCs as getUniqueAMCs } from '../data/funds';

const funds = exploreCards();
const uniqueAMCs = getUniqueAMCs();
---

<BaseLayout currentPage="explore">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">

  <!-- Hero -->
  <section class="mb-12 py-16 md:py-20 flex flex-col md:flex-row gap-12 items-end border-b border-outline-variant/20">
    <div class="flex-1">
      <span class="text-xs uppercase tracking-[0.3em] text-secondary font-bold mb-4 block">Institutional Fund Discovery</span>
      <h1 class="text-5xl md:text-7xl font-headline text-primary-container leading-tight">
        Discover Investment<br/><span class="italic font-light">Products</span>
      </h1>
    </div>
    <div class="w-full md:w-96">
      <div class="relative group">
        <span class="material-symbols-outlined absolute left-0 bottom-2 text-outline group-focus-within:text-tertiary-fixed-dim transition-colors">search</span>
        <input id="search-input" class="w-full bg-transparent border-b border-outline py-2 pl-8 text-sm focus:border-tertiary-fixed transition-all placeholder:text-outline-variant" placeholder="Search funds or managers..." type="text" />
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-32">

    <!-- ── Sidebar Filters ── -->
    <aside class="lg:col-span-3 space-y-10">

      <!-- Product Type (hierarchical) -->
      <div>
        <div class="flex items-center justify-between mb-5">
          <h4 class="text-[10px] uppercase tracking-widest text-outline font-bold">Product Type</h4>
          <button id="clear-types" class="text-[9px] uppercase tracking-widest text-secondary font-bold hover:opacity-70 transition-opacity hidden">Clear</button>
        </div>

        {/* PMS */}
        <div class="mb-4">
          <label class="flex items-center gap-2 mb-2 cursor-pointer group">
            <input type="checkbox" class="parent-check w-4 h-4 accent-secondary" data-parent="PMS" />
            <span class="text-[11px] font-bold uppercase tracking-widest text-primary-container group-hover:text-secondary transition-colors">PMS</span>
          </label>
          <div class="pl-6 flex flex-col gap-2" data-group="PMS">
            {['Discretionary','Non-Discretionary','Advisory'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="subtype-check w-3.5 h-3.5 accent-secondary" data-type="PMS" data-subtype={s} />
                <span class="text-xs text-on-surface-variant group-hover:text-primary-container transition-colors">{s}</span>
              </label>
            ))}
          </div>
        </div>

        {/* AIF Cat I */}
        <div class="mb-4">
          <label class="flex items-center gap-2 mb-2 cursor-pointer group">
            <input type="checkbox" class="parent-check w-4 h-4 accent-secondary" data-parent="AIF_CAT1" />
            <span class="text-[11px] font-bold uppercase tracking-widest text-primary-container group-hover:text-secondary transition-colors">AIF Category I</span>
          </label>
          <div class="pl-6 flex flex-col gap-2" data-group="AIF_CAT1">
            {['Venture Capital Funds','Angel Funds','Infrastructure Funds','Social Venture Funds','SME Funds'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="subtype-check w-3.5 h-3.5 accent-secondary" data-type="AIF_CAT1" data-subtype={s} />
                <span class="text-xs text-on-surface-variant group-hover:text-primary-container transition-colors">{s}</span>
              </label>
            ))}
          </div>
        </div>

        {/* AIF Cat II */}
        <div class="mb-4">
          <label class="flex items-center gap-2 mb-2 cursor-pointer group">
            <input type="checkbox" class="parent-check w-4 h-4 accent-secondary" data-parent="AIF_CAT2" />
            <span class="text-[11px] font-bold uppercase tracking-widest text-primary-container group-hover:text-secondary transition-colors">AIF Category II</span>
          </label>
          <div class="pl-6 flex flex-col gap-2" data-group="AIF_CAT2">
            {['Private Equity Funds','Debt Funds','Real Estate Funds','Distressed Asset Funds'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="subtype-check w-3.5 h-3.5 accent-secondary" data-type="AIF_CAT2" data-subtype={s} />
                <span class="text-xs text-on-surface-variant group-hover:text-primary-container transition-colors">{s}</span>
              </label>
            ))}
          </div>
        </div>

        {/* AIF Cat III */}
        <div class="mb-4">
          <label class="flex items-center gap-2 mb-2 cursor-pointer group">
            <input type="checkbox" class="parent-check w-4 h-4 accent-secondary" data-parent="AIF_CAT3" />
            <span class="text-[11px] font-bold uppercase tracking-widest text-primary-container group-hover:text-secondary transition-colors">AIF Category III</span>
          </label>
          <div class="pl-6 flex flex-col gap-2" data-group="AIF_CAT3">
            {['Long Only','Long Short','Multi-Strategy','Long Short — Market Neutral'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="subtype-check w-3.5 h-3.5 accent-secondary" data-type="AIF_CAT3" data-subtype={s} />
                <span class="text-xs text-on-surface-variant group-hover:text-primary-container transition-colors">{s}</span>
              </label>
            ))}
          </div>
        </div>

        {/* GIFT City */}
        <div class="mb-2">
          <label class="flex items-center gap-2 mb-2 cursor-pointer group">
            <input type="checkbox" class="parent-check w-4 h-4 accent-secondary" data-parent="GIFT_CITY" />
            <span class="text-[11px] font-bold uppercase tracking-widest text-primary-container group-hover:text-secondary transition-colors">GIFT City IFSC</span>
          </label>
          <div class="pl-6 flex flex-col gap-2" data-group="GIFT_CITY">
            {['Restricted Schemes','Retail Schemes'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="subtype-check w-3.5 h-3.5 accent-secondary" data-type="GIFT_CITY" data-subtype={s} />
                <span class="text-xs text-on-surface-variant group-hover:text-primary-container transition-colors">{s}</span>
              </label>
            ))}
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-outline-variant/20"></div>

      <!-- Asset Management -->
      <div>
        <h4 class="text-[10px] uppercase tracking-widest text-outline font-bold mb-5">Asset Management</h4>
        <div class="relative">
          <select id="amc-filter" class="w-full bg-transparent border border-outline-variant/30 px-3 py-2.5 text-xs focus:ring-0 focus:border-secondary appearance-none cursor-pointer pr-8">
            <option value="">All Managers</option>
            {uniqueAMCs.map(amc => <option value={amc}>{amc}</option>)}
          </select>
          <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline text-base pointer-events-none">expand_more</span>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-outline-variant/20"></div>

      <!-- AUM Range -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h4 class="text-[10px] uppercase tracking-widest text-outline font-bold">AUM Range</h4>
          <span id="aum-display" class="text-[11px] font-bold text-secondary">Up to ₹20,000 Cr</span>
        </div>
        <p class="text-[10px] text-outline-variant mb-4">Max AUM threshold</p>
        <div class="px-1">
          <input id="aum-slider" class="w-full h-1.5 bg-surface-container-highest appearance-none cursor-pointer accent-secondary rounded-full" type="range" min="0" max="20000" value="20000" step="500" />
          <div class="flex justify-between mt-3 text-[9px] font-bold text-outline uppercase tracking-tighter">
            <span>₹0</span><span>₹20,000 Cr</span>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-outline-variant/20"></div>

      <!-- Inception Age -->
      <div>
        <h4 class="text-[10px] uppercase tracking-widest text-outline font-bold mb-5">Inception Age</h4>
        <div class="grid grid-cols-2 gap-2">
          {[
            { label: 'All', val: 'all' },
            { label: '3Y+', val: '3' },
            { label: '5Y+', val: '5' },
            { label: '10Y+', val: '10' },
          ].map(opt => (
            <button class="inception-btn text-[11px] py-2 px-3 border transition-colors uppercase tracking-widest font-bold border-outline-variant hover:border-secondary text-on-surface-variant" data-age={opt.val}>
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-outline-variant/20"></div>

      <!-- Reset All -->
      <button id="reset-all" class="w-full text-[10px] uppercase tracking-widest font-bold text-outline border border-outline-variant/30 py-2.5 hover:border-secondary hover:text-secondary transition-colors">
        Reset All Filters
      </button>
    </aside>

    <!-- ── Results Grid ── -->
    <div class="lg:col-span-9">
      <div class="flex justify-between items-center mb-8">
        <p id="result-count" class="text-xs text-outline font-medium tracking-wide">Showing <span id="count-num">8</span> of <span id="count-total">{funds.length}</span> funds</p>
        <div class="flex items-center gap-4">
          <span class="text-[10px] uppercase font-bold tracking-widest text-outline">Sort:</span>
          <select id="sort-select" class="bg-transparent text-[10px] font-bold uppercase tracking-widest border-none focus:ring-0 p-0 cursor-pointer text-primary-container">
            <option value="default">Default</option>
            <option value="aum-desc">AUM High → Low</option>
            <option value="aum-asc">AUM Low → High</option>
            <option value="inception-desc">Newest First</option>
            <option value="inception-asc">Oldest First</option>
          </select>
        </div>
      </div>

      <!-- Fund Cards Grid -->
      <div id="funds-grid" class="grid grid-cols-1 md:grid-cols-2 gap-1 bg-surface-container-low border border-outline-variant/10">
        {funds.map((fund, i) => (
          <div
            class:list={['fund-card bg-surface-container-lowest flex flex-col justify-between transition-all group', i >= 8 ? 'initially-hidden' : '']}
            data-id={fund.id}
            data-type={fund.type}
            data-subtype={fund.subtype}
            data-amc={fund.amc}
            data-aum={fund.aum}
            data-inception={fund.inception}
            data-name={fund.name.toLowerCase()}
          >
            <div class="p-8">
              <div class="flex justify-between items-start mb-6">
                <span class="text-[9px] px-2 py-1 border uppercase font-bold tracking-widest
                  {fund.type === 'PMS' ? 'border-tertiary-fixed/40 text-amber-700 bg-tertiary-fixed/10' :
                   fund.type === 'AIF_CAT1' ? 'border-emerald-300/50 text-emerald-700 bg-emerald-50' :
                   fund.type === 'AIF_CAT2' ? 'border-blue-300/50 text-blue-700 bg-blue-50' :
                   fund.type === 'AIF_CAT3' ? 'border-violet-300/50 text-violet-700 bg-violet-50' :
                   'border-indigo-300/50 text-indigo-700 bg-indigo-50'}">{fund.tag}</span>
                <button class="compare-btn text-[9px] uppercase tracking-widest font-bold px-2 py-1 border border-outline-variant/40 text-outline hover:border-secondary hover:text-secondary transition-colors flex items-center gap-1" data-id={fund.id} data-name={fund.name} aria-label="Add to compare">
                  <span class="material-symbols-outlined text-sm">add</span>Compare
                </button>
              </div>
              <h3 class="text-xl font-headline text-primary-container mb-1 group-hover:translate-x-0.5 transition-transform">{fund.name}</h3>
              <p class="text-[10px] uppercase tracking-widest text-secondary font-bold mb-3">{fund.amc}</p>
              <p class="text-sm text-on-surface-variant leading-relaxed line-clamp-3">{fund.desc}</p>
            </div>
            <div class="px-8 pb-8">
              <div class="flex items-center justify-between pt-5 border-t border-surface-container">
                <div>
                  <span class="block text-[9px] uppercase text-outline font-bold tracking-tighter mb-1">AUM</span>
                  <span class="text-base font-bold text-primary-container">{fund.aumDisplay}</span>
                </div>
                <a href={fund.href} class="text-[9px] uppercase font-bold tracking-widest text-secondary flex items-center gap-1 hover:gap-2 transition-all">
                  Details <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- No results -->
      <div id="no-results" class="hidden py-24 text-center border border-outline-variant/20 mt-1">
        <span class="material-symbols-outlined text-5xl text-outline-variant mb-4 block">search_off</span>
        <p class="font-headline text-2xl text-primary-container mb-2">No funds match your filters</p>
        <p class="text-sm text-on-surface-variant mb-6">Try adjusting your filter criteria or reset all filters</p>
        <button id="no-results-reset" class="px-6 py-2.5 bg-secondary text-surface text-[10px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity">Reset Filters</button>
      </div>

      <!-- Load More -->
      <div id="load-more-wrap" class="mt-10 flex flex-col items-center gap-3">
        <button id="load-more-btn" class="px-8 py-3 border border-outline text-[10px] uppercase font-bold tracking-[0.2em] hover:bg-primary-container hover:text-white hover:border-primary-container transition-all">
          Load More Funds
        </button>
        <p id="load-more-hint" class="text-[10px] text-outline-variant uppercase tracking-widest"></p>
      </div>
    </div>
  </div>
</div>

<!-- ── Compare Floating Bar ── -->
<div id="compare-bar" class="fixed bottom-0 left-0 right-0 z-40 translate-y-full transition-transform duration-300 ease-out">
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
    <div class="bg-primary-container border-t-2 border-tertiary-fixed shadow-2xl px-6 py-4 flex items-center gap-4 flex-wrap">
      <span class="text-[10px] uppercase tracking-widest font-bold text-tertiary-fixed shrink-0">Compare Funds:</span>
      <div class="flex items-center gap-3 flex-1 flex-wrap">
        {[0,1,2].map(i => (
          <div class="compare-slot flex items-center gap-2 border border-secondary/40 px-3 py-2 min-w-[160px] bg-secondary/10" data-slot={i}>
            <span class="compare-slot-name text-[11px] text-surface/70 italic">Empty slot</span>
            <button class="compare-remove ml-auto text-tertiary-fixed/60 hover:text-tertiary-fixed transition-colors hidden" data-slot={i}>
              <span class="material-symbols-outlined text-base">close</span>
            </button>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a id="compare-now-btn" href="/compare" class="bg-tertiary-fixed text-on-tertiary-fixed px-5 py-2.5 text-[10px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity">
          Compare Now
        </a>
        <button id="compare-clear-all" class="text-surface/50 hover:text-surface transition-colors">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  /* ───── Constants ───── */
  const INITIAL_VISIBLE = 8;
  const LOAD_MORE_STEP  = 18; // show all on load more
  const CURRENT_YEAR    = 2026;
  const MAX_COMPARE     = 3;

  /* ───── State ───── */
  let loadCount     = INITIAL_VISIBLE;
  let filtersActive = false;
  let compareList   = []; // [{id, name}]

  /* ───── Elements ───── */
  const grid          = document.getElementById('funds-grid');
  const allCards      = Array.from(document.querySelectorAll('.fund-card'));
  const countNum      = document.getElementById('count-num');
  const countTotal    = document.getElementById('count-total');
  const loadMoreWrap  = document.getElementById('load-more-wrap');
  const loadMoreBtn   = document.getElementById('load-more-btn');
  const loadMoreHint  = document.getElementById('load-more-hint');
  const noResults     = document.getElementById('no-results');
  const searchInput   = document.getElementById('search-input');
  const amcFilter     = document.getElementById('amc-filter');
  const aumSlider     = document.getElementById('aum-slider');
  const aumDisplay    = document.getElementById('aum-display');
  const compareBar    = document.getElementById('compare-bar');
  const clearTypesBtn = document.getElementById('clear-types');
  const resetAllBtn   = document.getElementById('reset-all');
  const noResultsReset= document.getElementById('no-results-reset');

  /* ───── Helpers ───── */
  function getSelectedSubtypes() {
    const checked = document.querySelectorAll('.subtype-check:checked');
    return Array.from(checked).map(el => el.dataset.subtype);
  }

  function getActiveInceptionAge() {
    const active = document.querySelector('.inception-btn.is-active');
    return active ? active.dataset.age : 'all';
  }

  function aumValue() { return parseInt(aumSlider.value, 10); }

  function matchesFilters(card) {
    const subtypes    = getSelectedSubtypes();
    const amc         = amcFilter.value;
    const maxAUM      = aumValue();
    const age         = getActiveInceptionAge();
    const query       = searchInput.value.trim().toLowerCase();

    // Subtype filter
    if (subtypes.length > 0 && !subtypes.includes(card.dataset.subtype)) return false;
    // AMC filter
    if (amc && card.dataset.amc !== amc) return false;
    // AUM filter
    if (parseInt(card.dataset.aum, 10) > maxAUM) return false;
    // Inception age
    if (age !== 'all') {
      const fundAge = CURRENT_YEAR - parseInt(card.dataset.inception, 10);
      if (fundAge < parseInt(age, 10)) return false;
    }
    // Search
    if (query) {
      const name = card.dataset.name || '';
      const amc2 = (card.dataset.amc || '').toLowerCase();
      if (!name.includes(query) && !amc2.includes(query)) return false;
    }
    return true;
  }

  function checkFiltersActive() {
    const subtypes = getSelectedSubtypes();
    const amc      = amcFilter.value;
    const maxAUM   = aumValue();
    const age      = getActiveInceptionAge();
    const query    = searchInput.value.trim();
    filtersActive  = subtypes.length > 0 || !!amc || maxAUM < 20000 || age !== 'all' || !!query;
    clearTypesBtn.classList.toggle('hidden', getSelectedSubtypes().length === 0);
  }

  /* ───── Main render ───── */
  function applyFilters() {
    checkFiltersActive();
    const matching = allCards.filter(matchesFilters);
    const showAll  = filtersActive;
    const limit    = showAll ? matching.length : loadCount;

    let shown = 0;
    allCards.forEach(card => {
      const isMatch = matching.includes(card);
      const withinLimit = matching.indexOf(card) < limit;
      const visible = isMatch && withinLimit;
      card.style.display = visible ? '' : 'none';
      if (visible) shown++;
    });

    // Counts
    countNum.textContent   = shown;
    countTotal.textContent = allCards.length;

    // No results
    noResults.classList.toggle('hidden', matching.length > 0);
    grid.style.display = matching.length === 0 ? 'none' : '';

    // Load more
    const remaining = matching.length - limit;
    if (!filtersActive && remaining > 0) {
      loadMoreWrap.classList.remove('hidden');
      loadMoreHint.textContent = `${remaining} more fund${remaining !== 1 ? 's' : ''} available`;
    } else {
      loadMoreWrap.classList.add('hidden');
    }
  }

  /* ───── AUM slider live label ───── */
  function updateAUMLabel() {
    const val = aumValue();
    if (val >= 10000) {
      aumDisplay.textContent = `Up to ₹${(val/1000).toFixed(0)},000 Cr`;
    } else {
      aumDisplay.textContent = `Up to ₹${val.toLocaleString('en-IN')} Cr`;
    }
  }

  /* ───── Compare system ───── */
  function renderCompareBar() {
    const slots = document.querySelectorAll('.compare-slot');
    slots.forEach((slot, i) => {
      const entry = compareList[i];
      const nameEl   = slot.querySelector('.compare-slot-name');
      const removeEl = slot.querySelector('.compare-remove');
      if (entry) {
        nameEl.textContent = entry.name;
        nameEl.classList.remove('italic', 'text-surface/70');
        nameEl.classList.add('text-surface', 'font-semibold');
        removeEl.classList.remove('hidden');
        slot.classList.add('border-tertiary-fixed/60');
      } else {
        nameEl.textContent = 'Empty slot';
        nameEl.classList.add('italic', 'text-surface/70');
        nameEl.classList.remove('text-surface', 'font-semibold');
        removeEl.classList.add('hidden');
        slot.classList.remove('border-tertiary-fixed/60');
      }
    });

    // Bar visibility
    if (compareList.length > 0) {
      compareBar.classList.remove('translate-y-full');
    } else {
      compareBar.classList.add('translate-y-full');
    }

    // Update card button states
    allCards.forEach(card => {
      const btn   = card.querySelector('.compare-btn');
      const id    = card.dataset.id;
      const added = compareList.some(e => e.id === id);
      if (added) {
        btn.classList.add('border-secondary', 'text-secondary', 'bg-secondary/5');
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span>Added';
      } else {
        btn.classList.remove('border-secondary', 'text-secondary', 'bg-secondary/5');
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">add</span>Compare';
      }
    });
  }

  function toggleCompare(id, name) {
    const idx = compareList.findIndex(e => e.id === id);
    if (idx > -1) {
      compareList.splice(idx, 1);
    } else {
      if (compareList.length >= MAX_COMPARE) {
        // Flash bar to indicate full
        compareBar.classList.add('ring-2', 'ring-red-400');
        setTimeout(() => compareBar.classList.remove('ring-2', 'ring-red-400'), 600);
        return;
      }
      compareList.push({ id, name });
    }
    renderCompareBar();
  }

  /* ───── Parent checkbox logic ───── */
  document.querySelectorAll('.parent-check').forEach(parent => {
    parent.addEventListener('change', () => {
      const group = parent.dataset.parent;
      const children = document.querySelectorAll(`.subtype-check[data-type="${group}"]`);
      children.forEach(c => { c.checked = parent.checked; });
      applyFilters();
    });
  });

  document.querySelectorAll('.subtype-check').forEach(child => {
    child.addEventListener('change', () => {
      const group    = child.dataset.type;
      const parent   = document.querySelector(`.parent-check[data-parent="${group}"]`);
      const siblings = document.querySelectorAll(`.subtype-check[data-type="${group}"]`);
      const anyChecked = Array.from(siblings).some(s => s.checked);
      const allChecked = Array.from(siblings).every(s => s.checked);
      parent.checked       = allChecked;
      parent.indeterminate = anyChecked && !allChecked;
      applyFilters();
    });
  });

  /* ───── Filter controls ───── */
  searchInput.addEventListener('input', applyFilters);
  amcFilter.addEventListener('change', applyFilters);

  aumSlider.addEventListener('input', () => {
    updateAUMLabel();
    applyFilters();
  });

  /* Inception age buttons */
  document.querySelectorAll('.inception-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.inception-btn').forEach(b => {
        b.classList.remove('is-active', 'border-secondary', 'bg-secondary/5', 'text-secondary');
        b.classList.add('border-outline-variant', 'text-on-surface-variant');
      });
      btn.classList.add('is-active', 'border-secondary', 'bg-secondary/5', 'text-secondary');
      btn.classList.remove('border-outline-variant', 'text-on-surface-variant');
      applyFilters();
    });
  });

  /* Load more */
  loadMoreBtn.addEventListener('click', () => {
    loadCount = allCards.length; // show all
    applyFilters();
  });

  /* Clear types */
  clearTypesBtn.addEventListener('click', () => {
    document.querySelectorAll('.subtype-check, .parent-check').forEach(c => { c.checked = false; c.indeterminate = false; });
    applyFilters();
  });

  /* Reset all */
  function resetAll() {
    document.querySelectorAll('.subtype-check, .parent-check').forEach(c => { c.checked = false; c.indeterminate = false; });
    amcFilter.value  = '';
    aumSlider.value  = 20000;
    updateAUMLabel();
    document.querySelectorAll('.inception-btn').forEach(b => {
      b.classList.remove('is-active', 'border-secondary', 'bg-secondary/5', 'text-secondary');
      b.classList.add('border-outline-variant', 'text-on-surface-variant');
    });
    searchInput.value = '';
    loadCount = INITIAL_VISIBLE;
    applyFilters();
  }

  resetAllBtn.addEventListener('click', resetAll);
  noResultsReset.addEventListener('click', resetAll);

  /* Compare buttons on cards */
  allCards.forEach(card => {
    const btn = card.querySelector('.compare-btn');
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleCompare(card.dataset.id, card.querySelector('h3').textContent.trim());
    });
  });

  /* Compare slot remove buttons */
  document.querySelectorAll('.compare-remove').forEach(btn => {
    btn.addEventListener('click', () => {
      const slot = parseInt(btn.dataset.slot, 10);
      const entry = compareList[slot];
      if (entry) toggleCompare(entry.id, entry.name);
    });
  });

  /* Save selections to localStorage before navigating to compare page */
  document.getElementById('compare-now-btn').addEventListener('click', function () {
    try {
      var ids = compareList.map(function (f) { return f.id; });
      localStorage.setItem('compareIds', JSON.stringify(ids));
    } catch (e) {}
  });

  /* Compare clear all */
  document.getElementById('compare-clear-all').addEventListener('click', () => {
    compareList = [];
    renderCompareBar();
  });

  /* Sort */
  document.getElementById('sort-select').addEventListener('change', (e) => {
    const val = e.target.value;
    const sorted = [...allCards].sort((a, b) => {
      if (val === 'aum-desc') return parseInt(b.dataset.aum) - parseInt(a.dataset.aum);
      if (val === 'aum-asc')  return parseInt(a.dataset.aum) - parseInt(b.dataset.aum);
      if (val === 'inception-desc') return parseInt(b.dataset.inception) - parseInt(a.dataset.inception);
      if (val === 'inception-asc')  return parseInt(a.dataset.inception) - parseInt(b.dataset.inception);
      return 0; // default: original order
    });
    sorted.forEach(card => grid.appendChild(card));
    applyFilters();
  });

  /* ───── Init ───── */
  updateAUMLabel();
  applyFilters();

})();
</script>

</BaseLayout>
