    metric: 'IRR (Gross)', value: '18.7%',
    aum: 350, aumDisplay: '₹350 Cr', inception: 2019,
    href: '/funds/ian-angel-fund',
  },
  {
    id: 'nhai-infra-fund',
    type: 'AIF_CAT1', subtype: 'Infrastructure Funds',
    tag: 'AIF Cat I · Infrastructure',
    name: 'NHAI Infrastructure Fund I',
    amc: 'NHAI Infrastructure Trust',
    desc: 'Invests in HAM road projects and BOT highway concessions under NHAI\'s National Infrastructure Pipeline. Government annuity payments provide predictable, inflation-linked cash flows.',
    metric: 'Yield p.a.', value: '12.4%',
    aum: 8500, aumDisplay: '₹8,500 Cr', inception: 2018,
    href: '/funds/nhai-infra-fund',
  },
  {
    id: 'aavishkaar-social',
    type: 'AIF_CAT1', subtype: 'Social Venture Funds',
    tag: 'AIF Cat I · Social Venture',
    name: 'Aavishkaar Fund VIII',
    amc: 'Aavishkaar Capital',
    desc: 'Impact investment in financial inclusion, agri-value chains, and affordable healthcare enterprises serving rural India. IRIS+ impact metrics reported alongside financial performance.',
    metric: 'IRR (Gross)', value: '14.2%',
    aum: 650, aumDisplay: '₹650 Cr', inception: 2020,
    href: '/funds/aavishkaar-social',
  },
  {
    id: 'edelweiss-sme-fund',
    type: 'AIF_CAT1', subtype: 'SME Funds',
    tag: 'AIF Cat I · SME',
    name: 'Edelweiss SME Growth Fund II',
    amc: 'Edelweiss Asset Management',
    desc: 'Growth equity investments in profitable Indian SMEs with ₹50–300 Cr revenue. Focus on specialty chemicals, auto ancillaries, pharma API, and technical textiles with BSE SME exit pathway.',
    metric: 'IRR (Gross)', value: '20.1%',
    aum: 1800, aumDisplay: '₹1,800 Cr', inception: 2017,
    href: '/funds/edelweiss-sme-fund',
  },
  /* ── AIF CAT II ───────────────────────────────────────── */
