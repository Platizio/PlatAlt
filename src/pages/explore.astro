---
import BaseLayout from '../layouts/BaseLayout.astro';

const funds = [
  /* ── PMS ──────────────────────────────────────────────── */
  {
    id: 'motilal-value-pms',
    type: 'PMS', subtype: 'Discretionary',
    tag: 'PMS · Discretionary',
    name: 'Motilal Oswal Value Strategy',
    amc: 'Motilal Oswal AMC',
