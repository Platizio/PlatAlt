---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Social Venture Funds | The Sovereign Ledger" currentPage="products/funds/social-venture">

<div class="max-w-5xl mx-auto px-6 md:px-10 py-8">
  <div class="flex items-center gap-2 text-secondary mb-8 pt-4 flex-wrap">
    <a href="/knowledge/aif" class="text-xs uppercase tracking-[0.2em] font-label hover:text-primary-container transition-colors">AIF Knowledge</a>
    <span class="material-symbols-outlined text-[12px]">chevron_right</span>
    <span class="text-xs uppercase tracking-[0.2em] font-label text-secondary">Cat I AIF</span>
    <span class="material-symbols-outlined text-[12px]">chevron_right</span>
    <span class="text-xs uppercase tracking-[0.2em] font-label text-on-surface">Social Venture</span>
  </div>

  <section class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <span class="bg-tertiary-fixed/20 text-on-tertiary-container text-[10px] font-bold uppercase tracking-widest px-3 py-1">Category I AIF</span>
    </div>
    <h1 class="font-headline text-5xl md:text-6xl font-light leading-tight text-primary-container mb-4">
      Social Venture <span class="italic">Funds</span>
    </h1>
    <p class="text-on-surface-variant leading-relaxed text-lg max-w-2xl">
      Deploying capital into enterprises that generate measurable social and environmental impact alongside competitive financial returns.
    </p>
  </section>

  <section class="mb-16">
    <div class="bg-surface-container-low p-8 md:p-10">
      <h2 class="font-headline text-2xl mb-6 text-primary-container">Definition & Purpose</h2>
      <p class="text-on-surface-variant leading-relaxed mb-8">
        Social Venture Funds are a sub-category of Category I AIFs explicitly recognized by SEBI for investing in enterprises that prioritize social or environmental objectives. These funds apply a dual mandate — achieving financial returns while creating quantifiable positive impact in areas such as education, healthcare, clean energy, water, and financial inclusion.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-surface-container-lowest p-4">
          <span class="material-symbols-outlined text-secondary mb-2 block">volunteer_activism</span>
          <h4 class="text-xs font-label uppercase tracking-wider text-secondary mb-1">Mandate</h4>
          <p class="text-sm font-semibold">Impact + Returns</p>
        </div>
        <div class="bg-surface-container-lowest p-4">
          <span class="material-symbols-outlined text-secondary mb-2 block">monitoring</span>
          <h4 class="text-xs font-label uppercase tracking-wider text-secondary mb-1">Risk Profile</h4>
          <p class="text-sm font-semibold">Medium–High</p>
        </div>
        <div class="bg-surface-container-lowest p-4">
          <span class="material-symbols-outlined text-secondary mb-2 block">payments</span>
          <h4 class="text-xs font-label uppercase tracking-wider text-secondary mb-1">Min. Investment</h4>
          <p class="text-sm font-semibold">&#8377;1 Crore</p>
        </div>
        <div class="bg-surface-container-lowest p-4">
          <span class="material-symbols-outlined text-secondary mb-2 block">schedule</span>
          <h4 class="text-xs font-label uppercase tracking-wider text-secondary mb-1">Tenure</h4>
          <p class="text-sm font-semibold">7&ndash;10 Years</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-headline text-3xl mb-10 text-primary-container pl-4 border-l-2 border-tertiary-fixed">
      Impact <span class="italic">Sectors</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        { icon: 'school', title: 'Education', desc: 'EdTech platforms, affordable private schools, and vocational training reaching underserved populations.' },
        { icon: 'local_hospital', title: 'Healthcare', desc: 'Affordable diagnostics, telemedicine, and last-mile primary healthcare delivery in Tier 2/3 cities.' },
        { icon: 'solar_power', title: 'Clean Energy', desc: 'Distributed solar, clean cooking, and rural electrification solutions reducing energy poverty and carbon emissions.' },
        { icon: 'water_drop', title: 'Water & Sanitation', desc: 'Community water infrastructure, affordable purification technology, and sustainable sanitation solutions.' },
        { icon: 'account_balance_wallet', title: 'Financial Inclusion', desc: 'Microfinance, digital lending, and insurance products for India\'s 300M+ unbanked and underbanked population.' },
        { icon: 'agriculture', title: 'AgriTech', desc: 'Precision farming, supply chain, and market linkage solutions improving farmer income and food security.' },
      ].map(s => (
        <div class="flex gap-5 items-start bg-surface-container-lowest p-5">
          <span class="material-symbols-outlined text-secondary text-2xl shrink-0">{s.icon}</span>
          <div>
            <h3 class="font-headline text-lg mb-2">{s.title}</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16 bg-primary-container text-surface p-8 md:p-12">
    <h2 class="font-headline text-3xl mb-8 text-tertiary-fixed">Impact <span class="italic">Measurement</span></h2>
    <p class="text-sm opacity-80 mb-8 max-w-xl">Social Venture Funds are required to report standardized impact metrics alongside financial performance, providing investors with a complete picture of value creation.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { label: 'Output Metrics', ex: 'Lives reached, products sold, loans disbursed' },
        { label: 'Outcome Metrics', ex: 'Income improvement, health outcomes, emissions avoided' },
        { label: 'Impact Metrics', ex: 'Counterfactual assessment, additionality, SROI' },
      ].map(m => (
        <div class="border border-secondary/30 p-6">
          <p class="font-headline text-lg mb-2">{m.label}</p>
          <p class="text-xs opacity-60 leading-relaxed">{m.ex}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="bg-surface-container p-8 text-center border border-outline-variant/10">
    <h3 class="font-headline text-2xl mb-4">Align Capital with Purpose</h3>
    <p class="text-on-surface-variant text-sm mb-8">Our impact investment team can help you identify Social Venture Funds aligned with your values and financial objectives.</p>
    <a href="/partner" class="inline-block py-4 px-10 bg-primary-container text-on-primary font-label text-xs uppercase tracking-[0.2em] hover:bg-slate-800 transition-colors">
      Explore Impact Funds
    </a>
  </div>
</div>

</BaseLayout>
