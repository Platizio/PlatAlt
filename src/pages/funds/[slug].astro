---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllFunds, getFund, tagFor, subtypeDisplay, aumDisplay, headlineMetric,
  returnByPeriod, sourceLabel, NOT_DISCLOSED, PERFORMANCE_DISCLAIMER,
} from '../../data/funds';
import { seoForFund } from '../../data/seo';
import { fundNode } from '../../data/schema';

export function getStaticPaths() {
  return getAllFunds().map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const fund = getFund(slug!);
if (!fund) return Astro.redirect('/explore');

const seo = seoForFund(fund);

/* ── Colour tokens per type ── */
const clr = {
  PMS:       { accent: 'text-amber-300',  border: 'border-amber-700/40',  bg: 'bg-amber-900/25',   badge: 'bg-amber-900/30 text-amber-200 border border-amber-700/40'  },
  AIF_CAT1:  { accent: 'text-emerald-300',border: 'border-emerald-700/40',bg: 'bg-emerald-900/25', badge: 'bg-emerald-900/30 text-emerald-300 border border-emerald-700/40'},
  AIF_CAT2:  { accent: 'text-blue-300',   border: 'border-blue-700/40',   bg: 'bg-blue-900/25',    badge: 'bg-blue-900/30 text-blue-300 border border-blue-700/40'      },
  AIF_CAT3:  { accent: 'text-violet-300', border: 'border-violet-700/40', bg: 'bg-violet-900/25',  badge: 'bg-violet-900/30 text-violet-300 border border-violet-700/40' },
  GIFT_CITY: { accent: 'text-indigo-300', border: 'border-indigo-700/40', bg: 'bg-indigo-900/25',  badge: 'bg-indigo-900/30 text-indigo-300 border border-indigo-700/40' },
}[fund.site_type];

const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : NOT_DISCLOSED;

const metric = headlineMetric(fund);

/* ── Stat cells (only real, sourced values) ── */
const aumAttr = fund.aum_as_of
  ? `as on ${fmtDate(fund.aum_as_of)} · ${sourceLabel(fund.aum_source)}`
  : (fund.aum_cr == null ? 'not officially disclosed' : '');

const statCells = [
  { label: 'Fund Type',        value: subtypeDisplay(fund), note: '' },
  { label: 'AUM',              value: aumDisplay(fund),     note: aumAttr },
  { label: 'Benchmark',        value: fund.benchmark ?? NOT_DISCLOSED, note: '' },
  { label: 'Inception',        value: fmtDate(fund.inception_date), note: fund.inception_date ? 'registration date' : '' },
  { label: 'Min. Investment',  value: fund.min_investment ?? NOT_DISCLOSED, note: '' },
  { label: 'SEBI Reg. No.',    value: fund.reg_no ?? NOT_DISCLOSED, note: '' },
];

/* ── Returns table ── */
const PERIODS = [
  { key: '1M', label: '1 Month' }, { key: '3M', label: '3 Months' },
  { key: '6M', label: '6 Months' }, { key: '1Y', label: '1 Year' },
  { key: '3Y', label: '3 Years' }, { key: '5Y', label: '5 Years' },
  { key: 'SI', label: 'Since Inception' },
];
const returnRows = PERIODS.map((p) => {
  const r = returnByPeriod(fund, p.key);
  return { label: p.label, value: r && r.return_pct != null ? `${r.return_pct.toFixed(2)}%` : '—' };
});
const hasReturns = fund.returns.some((r) => r.return_pct != null);
const returnsAsOf = fund.returns.find((r) => r.return_pct != null)?.as_of ?? null;
const returnsSource = sourceLabel(fund.returns[0]?.source ?? null);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  currentPage="explore"
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Fund Explorer', item: '/explore' },
    { name: fund.amc, item: `/amc/${fund.amc_slug}` },
    { name: fund.name },
  ]}
  schema={[fundNode(fund)]}
>

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-28">

  <!-- ── Breadcrumb ── -->
  <nav class="py-5 flex items-center gap-2 text-[10px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/explore" class="hover:text-secondary transition-colors">Fund Explorer</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <a href={`/amc/${fund.amc_slug}`} class="hover:text-secondary transition-colors">{fund.amc}</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">{fund.name}</span>
  </nav>

  <!-- ── Hero ── -->
  <section class="pt-10 pb-8 border-b border-outline-variant/20">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`text-[10px] px-3 py-1.5 uppercase font-bold tracking-widest ${clr.badge}`}>{tagFor(fund)}</span>
          <a href={`/amc/${fund.amc_slug}`} class="text-[10px] px-3 py-1.5 font-bold uppercase tracking-widest border border-outline-variant/40 text-on-surface-variant hover:border-secondary hover:text-secondary transition-colors">
            {fund.amc} <span class="material-symbols-outlined text-xs align-middle ml-0.5">open_in_new</span>
          </a>
        </div>
        <h1 class="text-4xl md:text-6xl font-headline text-primary-container leading-tight mb-3">{fund.name}</h1>
        <p class="text-sm text-on-surface-variant max-w-2xl leading-relaxed">{fund.description}</p>
      </div>
      <!-- Key metric pill -->
      <div class={`shrink-0 ${clr.bg} ${clr.border} border px-8 py-6 text-center min-w-[180px]`}>
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">{metric.label}</p>
        <p class={`text-3xl font-bold font-headline ${clr.accent}`}>{metric.value}</p>
      </div>
    </div>
  </section>

  <!-- ── Stats Bar ── -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 border border-outline-variant/20 mb-12">
    {statCells.map((cell, i) => (
      <div class={`px-6 py-5 ${i < statCells.length - 1 ? 'border-b sm:border-b-0 sm:border-r border-outline-variant/20' : ''}`}>
        <p class="text-[9px] uppercase tracking-widest font-bold text-outline mb-1.5">{cell.label}</p>
        <p class="text-sm font-bold text-primary-container leading-tight break-words">{cell.value}</p>
        {cell.note && <p class="text-[9px] text-outline-variant mt-1 lowercase tracking-wide">{cell.note}</p>}
      </div>
    ))}
  </div>

  <!-- ── Performance ── -->
  <section class="mb-12">
    <div class="flex items-center gap-3 mb-6">
      <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">trending_up</span>
      <h2 class="font-headline text-2xl text-primary-container">Standardized Performance</h2>
    </div>
    {hasReturns ? (
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8">
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-px bg-outline-variant/10 border border-outline-variant/10">
          {returnRows.map((row) => (
            <div class="bg-surface-container-lowest px-4 py-5 text-center">
              <p class="text-[9px] uppercase tracking-widest font-bold text-outline mb-2">{row.label}</p>
              <p class={`text-lg font-bold font-headline ${row.value.startsWith('-') ? 'text-red-400' : clr.accent}`}>{row.value}</p>
            </div>
          ))}
        </div>
        <p class="text-[10px] text-outline-variant mt-4 tracking-wide">
          TWRR returns as on {fmtDate(returnsAsOf)} · Source: {returnsSource}
          {fund.benchmark && <> · Benchmark: {fund.benchmark}</>}
        </p>
      </div>
    ) : (
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 text-center">
        <span class="material-symbols-outlined text-4xl text-outline-variant mb-3 block">visibility_off</span>
        <p class="font-headline text-xl text-primary-container mb-1">Performance not officially disclosed</p>
        <p class="text-sm text-on-surface-variant max-w-md mx-auto">
          Fund-level performance for this {fund.site_type.startsWith('AIF') ? 'AIF' : 'fund'} is not
          published in SEBI / APMI disclosures. Only regulator-confirmed identity and
          registration details are shown.
        </p>
      </div>
    )}
  </section>

  <!-- ── Fund Details ── -->
  {fund.fund_details.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">description</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Details</h2>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant/10 divide-y divide-outline-variant/10">
        {fund.fund_details.map((d) => (
          <div class="flex justify-between gap-6 px-8 py-4">
            <span class="text-xs uppercase tracking-widest font-bold text-outline">{d.label}</span>
            <span class="text-sm font-semibold text-primary-container text-right">{d.value}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── Provenance & disclaimer ── -->
  <section class="border-t border-outline-variant/20 pt-6">
    <p class="text-[10px] text-outline-variant leading-relaxed max-w-3xl">
      {PERFORMANCE_DISCLAIMER}
      {fund.last_synced_at && <> Last refreshed {fmtDate(fund.last_synced_at.slice(0, 10))}.</>}
    </p>
  </section>

</div>
</BaseLayout>
