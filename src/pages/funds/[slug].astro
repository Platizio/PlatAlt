    'marcellus-long-only', 'avendus-long-short', 'iifl-multi-strategy', 'tata-market-neutral',
    'kotak-gift-restricted', 'mirae-gift-retail',
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

