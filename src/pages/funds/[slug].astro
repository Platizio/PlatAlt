  AIF_CAT2:  { accent: 'text-blue-300',   border: 'border-blue-700/40',   bg: 'bg-blue-900/25',    badge: 'bg-blue-900/30 text-blue-300 border border-blue-700/40',       icon: 'text-blue-400',    sep: 'border-blue-700/30'   },
  AIF_CAT3:  { accent: 'text-violet-300', border: 'border-violet-700/40', bg: 'bg-violet-900/25',  badge: 'bg-violet-900/30 text-violet-300 border border-violet-700/40',  icon: 'text-violet-400',  sep: 'border-violet-700/30' },
  GIFT_CITY: { accent: 'text-indigo-300', border: 'border-indigo-700/40', bg: 'bg-indigo-900/25',  badge: 'bg-indigo-900/30 text-indigo-300 border border-indigo-700/40',  icon: 'text-indigo-400',  sep: 'border-indigo-700/30' },
}[fund.type];

/* ── Stats bar cells per type ── */
const statCells = isPMS ? [
  { label: 'Fund Type',     value: fund.subtype },
  { label: 'As on',         value: fund.asOn },
  { label: 'Benchmark',     value: fund.benchmark },
  { label: 'Inception Date',value: fund.inception },
  { label: 'Min. Investment',value: fund.minInvestment },
  { label: 'AUM',           value: fund.aum },
] : isAIF12 ? [
  { label: 'Fund Type',       value: fund.subtype },
  { label: 'Fund Target Size',value: fund.targetSize },
  { label: 'Fund Tenure',     value: fund.tenure },
  { label: 'Min. Commitment', value: fund.minCommitment },
  { label: 'Fund Structure',  value: fund.structure },
] : isAIF3 ? [
  { label: 'Fund Type',     value: fund.subtype },
  { label: 'Benchmark',     value: fund.benchmark },
  { label: 'Inception Date',value: fund.inception },
  { label: 'Min. Investment',value: fund.minInvestment },
  { label: 'AUM',           value: fund.aum },
] : [
  { label: 'Fund Type',      value: fund.subtype },
  { label: 'Min. Investment',value: fund.minInvestment },
  { label: 'Structure',      value: fund.structure },
];

const statColClass = statCells.length <= 3 ? 'grid-cols-1 sm:grid-cols-3'
  : statCells.length <= 4 ? 'grid-cols-2 md:grid-cols-4'
  : statCells.length === 5 ? 'grid-cols-2 md:grid-cols-3 lg:grid-cols-5'
  : 'grid-cols-2 md:grid-cols-3 lg:grid-cols-6';
---

<BaseLayout title={`${fund.name} | Fund Detail | PlatAlt`} currentPage="explore">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-28">

  <!-- ── Breadcrumb ── -->
  <nav class="py-5 flex items-center gap-2 text-[10px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/explore" class="hover:text-secondary transition-colors">Fund Explorer</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <a href={`/amc/${fund.amcSlug}`} class="hover:text-secondary transition-colors">{fund.amc}</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">{fund.name}</span>
  </nav>

  <!-- ── Hero ── -->
  <section class="pt-10 pb-8 border-b border-outline-variant/20">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`text-[10px] px-3 py-1.5 uppercase font-bold tracking-widest ${clr.badge}`}>{fund.tag}</span>
          <a href={`/amc/${fund.amcSlug}`} class={`text-[10px] px-3 py-1.5 font-bold uppercase tracking-widest border border-outline-variant/40 text-on-surface-variant hover:border-secondary hover:text-secondary transition-colors`}>
            {fund.amc} <span class="material-symbols-outlined text-xs align-middle ml-0.5">open_in_new</span>
          </a>
        </div>
        <h1 class="text-4xl md:text-6xl font-headline text-primary-container leading-tight mb-3">
          {fund.name}
        </h1>
      </div>
      <!-- Key metric pill -->
      <div class={`shrink-0 ${clr.bg} ${clr.border} border px-8 py-6 text-center min-w-[180px]`}>
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">{fund.metric.label}</p>
        <p class={`text-3xl font-bold font-headline ${clr.accent}`}>{fund.metric.value}</p>
      </div>
    </div>
  </section>

  <!-- ── Stats Bar ── -->
  <div class={`grid ${statColClass} border border-outline-variant/20 mb-12`}>
    {statCells.map((cell, i) => (
      <div class={`px-6 py-5 ${i < statCells.length - 1 ? 'border-b md:border-b-0 md:border-r border-outline-variant/20' : ''}`}>
        <p class="text-[9px] uppercase tracking-widest font-bold text-outline mb-1.5">{cell.label}</p>
        <p class="text-sm font-bold text-primary-container leading-tight">{cell.value}</p>
      </div>
    ))}
  </div>

  <!-- ════════════════════════════════════════════════
       PMS — SPECIFIC SECTIONS
  ════════════════════════════════════════════════ -->

  {/* 1. Fund Manager Info */}
  {isPMS && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">person</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Manager</h2>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 flex flex-col md:flex-row gap-8">
        <div class={`w-16 h-16 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0`}>
          <span class={`material-symbols-outlined text-3xl ${clr.icon}`} style="font-variation-settings:'FILL' 1">person</span>
        </div>
        <div>
          <h3 class="font-headline text-xl text-primary-container mb-1">{fund.manager.name}</h3>
          <p class={`text-[11px] uppercase tracking-widest font-bold ${clr.accent} mb-3`}>{fund.manager.title}</p>
          <p class="text-xs font-semibold text-outline uppercase tracking-widest mb-4 border-l-2 border-outline-variant/40 pl-3">{fund.manager.experience}</p>
          <p class="text-sm text-on-surface-variant leading-relaxed">{fund.manager.bio}</p>
        </div>
      </div>
    </section>
  )}

  {/* 2. Investment Approach vs Benchmark */}
  {isPMS && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">compare_arrows</span>
        <h2 class="font-headline text-2xl text-primary-container">Investment Approach vs Benchmark</h2>
      </div>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-8 max-w-3xl">{fund.approachVsBenchmark.intro}</p>
      <div class="border border-outline-variant/20 overflow-hidden">
        <div class="grid grid-cols-3 bg-surface-container px-6 py-3 border-b border-outline-variant/20">
          <span class="text-[10px] uppercase tracking-widest font-bold text-outline">Metric</span>
          <span class={`text-[10px] uppercase tracking-widest font-bold ${clr.accent}`}>This Strategy</span>
          <span class="text-[10px] uppercase tracking-widest font-bold text-outline">Benchmark</span>
        </div>
        {fund.approachVsBenchmark.rows.map((row: any, i: number) => (
          <div class={`grid grid-cols-3 px-6 py-4 ${i % 2 === 0 ? 'bg-surface-container-lowest' : 'bg-surface-container/30'} border-b border-outline-variant/10 last:border-b-0`}>
            <span class="text-sm font-semibold text-on-surface-variant">{row.label}</span>
            <span class={`text-sm font-bold ${clr.accent}`}>{row.portfolio}</span>
            <span class="text-sm text-outline">{row.benchmark}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 3. Investment Philosophy */}
  {isPMS && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-2">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">lightbulb</span>
        <h2 class="font-headline text-2xl text-primary-container">Investment Philosophy</h2>
      </div>
      <p class={`font-headline italic text-xl ${clr.accent} mb-4`}>{fund.philosophy.heading}</p>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-10 max-w-3xl">{fund.philosophy.text}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {fund.philosophy.principles.map((p: any) => (
          <div class={`${clr.bg} border ${clr.border} p-6`}>
            <span class={`material-symbols-outlined text-2xl ${clr.icon} mb-4 block`} style="font-variation-settings:'FILL' 1">{p.icon}</span>
            <h4 class="font-headline text-base text-primary-container mb-2">{p.title}</h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 4. Strategy Information */}
  {isPMS && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">account_tree</span>
        <h2 class="font-headline text-2xl text-primary-container">Strategy Information</h2>
      </div>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-8 max-w-3xl">{fund.strategy.text}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {fund.strategy.details.map((d: any) => (
          <div class="bg-surface-container-lowest border border-outline-variant/10 p-5">
            <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">{d.label}</p>
            <p class={`text-sm font-bold ${clr.accent}`}>{d.value}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 5. Fund Details (PMS) */}
  {isPMS && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">info</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Details</h2>
      </div>
      <div class="border border-outline-variant/20 overflow-hidden">
        {fund.fundDetails.map((row: any, i: number) => (
          <div class={`grid grid-cols-1 md:grid-cols-2 gap-0 border-b border-outline-variant/10 last:border-b-0 ${i % 2 === 0 ? 'bg-surface-container-lowest' : 'bg-surface-container/20'}`}>
            <div class="px-6 py-4 border-b md:border-b-0 md:border-r border-outline-variant/10">
              <p class="text-[10px] uppercase tracking-widest font-bold text-outline">{row.label}</p>
            </div>
            <div class="px-6 py-4">
              <p class="text-sm text-primary-container font-medium">{row.value}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════════
       AIF CAT I & II — SPECIFIC SECTIONS
  ════════════════════════════════════════════════ -->

  {/* 1. About the Fund */}
  {isAIF12 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">description</span>
        <h2 class="font-headline text-2xl text-primary-container">About the Fund</h2>
      </div>
      <div class="max-w-4xl space-y-5">
        {fund.about.map((para: string) => (
          <p class="text-sm text-on-surface-variant leading-relaxed">{para}</p>
        ))}
      </div>
    </section>
  )}

  {/* 2. Fund Manager Details (AIF Cat I/II) */}
  {isAIF12 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">manage_accounts</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Manager Details</h2>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 flex flex-col md:flex-row gap-8">
        <div class={`w-16 h-16 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0`}>
          <span class={`material-symbols-outlined text-3xl ${clr.icon}`} style="font-variation-settings:'FILL' 1">person</span>
        </div>
        <div class="flex-1">
          <h3 class="font-headline text-xl text-primary-container mb-1">{fund.manager.name}</h3>
          <p class={`text-[11px] uppercase tracking-widest font-bold ${clr.accent} mb-3`}>{fund.manager.title}</p>
          <p class="text-xs font-semibold text-outline uppercase tracking-widest mb-4 border-l-2 border-outline-variant/40 pl-3">{fund.manager.experience}</p>
          <p class="text-sm text-on-surface-variant leading-relaxed">{fund.manager.bio}</p>
        </div>
      </div>
    </section>
  )}

  {/* 3. Fund Details (AIF Cat I/II) */}
  {isAIF12 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">info</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Details</h2>
      </div>
      <div class="border border-outline-variant/20 overflow-hidden">
        {fund.fundDetails.map((row: any, i: number) => (
          <div class={`grid grid-cols-1 md:grid-cols-2 border-b border-outline-variant/10 last:border-b-0 ${i % 2 === 0 ? 'bg-surface-container-lowest' : 'bg-surface-container/20'}`}>
            <div class="px-6 py-4 border-b md:border-b-0 md:border-r border-outline-variant/10">
              <p class="text-[10px] uppercase tracking-widest font-bold text-outline">{row.label}</p>
            </div>
            <div class="px-6 py-4">
              <p class="text-sm text-primary-container font-medium">{row.value}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════════
       AIF CAT III — SPECIFIC SECTIONS
  ════════════════════════════════════════════════ -->

  {/* 1. About the Fund */}
  {isAIF3 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">description</span>
        <h2 class="font-headline text-2xl text-primary-container">About the Fund</h2>
      </div>
      <div class="max-w-4xl space-y-5">
        {fund.about.map((para: string) => (
          <p class="text-sm text-on-surface-variant leading-relaxed">{para}</p>
        ))}
      </div>
    </section>
  )}

  {/* 2. Fund Manager Details (AIF Cat III) */}
  {isAIF3 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">manage_accounts</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Manager Details</h2>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 flex flex-col md:flex-row gap-8">
        <div class={`w-16 h-16 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0`}>
          <span class={`material-symbols-outlined text-3xl ${clr.icon}`} style="font-variation-settings:'FILL' 1">person</span>
        </div>
        <div class="flex-1">
          <h3 class="font-headline text-xl text-primary-container mb-1">{fund.manager.name}</h3>
          <p class={`text-[11px] uppercase tracking-widest font-bold ${clr.accent} mb-3`}>{fund.manager.title}</p>
          <p class="text-xs font-semibold text-outline uppercase tracking-widest mb-4 border-l-2 border-outline-variant/40 pl-3">{fund.manager.experience}</p>
          <p class="text-sm text-on-surface-variant leading-relaxed">{fund.manager.bio}</p>
        </div>
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════════
       GIFT CITY — SPECIFIC SECTIONS
  ════════════════════════════════════════════════ -->

  {/* 1. Fund Manager Details (GIFT City) */}
  {isGIFT && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">manage_accounts</span>
        <h2 class="font-headline text-2xl text-primary-container">Fund Manager Details</h2>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant/10 p-8 flex flex-col md:flex-row gap-8">
        <div class={`w-16 h-16 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0`}>
          <span class={`material-symbols-outlined text-3xl ${clr.icon}`} style="font-variation-settings:'FILL' 1">groups</span>
        </div>
        <div class="flex-1">
          <h3 class="font-headline text-xl text-primary-container mb-1">{fund.manager.name}</h3>
          <p class={`text-[11px] uppercase tracking-widest font-bold ${clr.accent} mb-3`}>{fund.manager.title}</p>
          <p class="text-xs font-semibold text-outline uppercase tracking-widest mb-4 border-l-2 border-outline-variant/40 pl-3">{fund.manager.experience}</p>
          <p class="text-sm text-on-surface-variant leading-relaxed">{fund.manager.bio}</p>
        </div>
      </div>
    </section>
  )}

  {/* 2. Investment Objective */}
  {isGIFT && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">flag</span>
        <h2 class="font-headline text-2xl text-primary-container">Investment Objective</h2>
      </div>
      <div class={`${clr.bg} border ${clr.border} p-8 max-w-4xl`}>
        <p class="text-base text-primary-container leading-relaxed font-medium">{fund.objective}</p>
      </div>
    </section>
  )}

  {/* 3. Investment Philosophy (GIFT City) */}
  {isGIFT && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-2">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">lightbulb</span>
        <h2 class="font-headline text-2xl text-primary-container">Investment Philosophy</h2>
      </div>
      <p class={`font-headline italic text-xl ${clr.accent} mb-4`}>{fund.philosophy.heading}</p>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-10 max-w-3xl">{fund.philosophy.text}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {fund.philosophy.principles.map((p: any) => (
          <div class={`${clr.bg} border ${clr.border} p-6`}>
            <span class={`material-symbols-outlined text-2xl ${clr.icon} mb-4 block`} style="font-variation-settings:'FILL' 1">{p.icon}</span>
            <h4 class="font-headline text-base text-primary-container mb-2">{p.title}</h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 4. Investment Strategy & Process (GIFT City) */}
  {isGIFT && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">account_tree</span>
        <h2 class="font-headline text-2xl text-primary-container">Investment Strategy &amp; Process</h2>
      </div>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-8 max-w-3xl">{fund.strategy.text}</p>
      <div class="space-y-3">
        {fund.strategy.steps.map((step: any, i: number) => (
          <div class="flex gap-5 bg-surface-container-lowest border border-outline-variant/10 p-6">
            <div class={`w-8 h-8 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0 mt-0.5`}>
              <span class={`text-[11px] font-bold ${clr.accent}`}>{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div>
              <h4 class="font-semibold text-sm text-primary-container mb-1">{step.label}</h4>
              <p class="text-sm text-on-surface-variant leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════════
       COMMON FOOTER CTA
  ════════════════════════════════════════════════ -->
  <div class="border border-outline-variant/20 bg-surface-container-low px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6 mt-4">
    <div>
      <h3 class="font-headline text-2xl text-primary-container mb-1">Interested in this fund?</h3>
      <p class="text-sm text-on-surface-variant">Speak with our institutional advisory team for eligibility, documentation, and onboarding.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a href={`/amc/${fund.amcSlug}`} class="inline-flex items-center gap-2 border border-secondary text-secondary px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:bg-secondary/5 transition-colors">
        View AMC Profile <span class="material-symbols-outlined text-sm">open_in_new</span>
      </a>
      <button type="button" class="js-open-consult inline-flex items-center gap-2 bg-amber-200 text-slate-900 px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:bg-amber-100 transition-colors cursor-pointer">
        Request Consultation <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </button>
    </div>
  </div>

</div>
</BaseLayout>
