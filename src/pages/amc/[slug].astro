export function getStaticPaths() {
  // Hardcode slugs here — avoids Astro module-scope hoisting issue
  // (amcs is instance-scope and not accessible from getStaticPaths at build time)
  const slugs = [
    'motilal-oswal-amc',
    'iifl-asset-management',
    'kotak-mahindra-amc',
    'blume-ventures',
    'indian-angel-network',
    'nhai-infrastructure-trust',
    'aavishkaar-capital',
    'edelweiss-asset-management',
    'chryscapital',
    'altico-capital',
    'marcellus-investment-managers',
    'avendus-capital',
    'tata-asset-management',
    'kotak-ifsc-asset-management',
    'mirae-asset-ifsc',
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const amc = amcs[slug];
if (!amc) return Astro.redirect('/amc');

const categoryBadgeStyle = {
  PMS:        'bg-amber-100 text-amber-800 border border-amber-300/50',
  AIF_CAT1:   'bg-emerald-100 text-emerald-800 border border-emerald-300/50',
  AIF_CAT2:   'bg-blue-100 text-blue-800 border border-blue-300/50',
  AIF_CAT3:   'bg-violet-100 text-violet-800 border border-violet-300/50',
  GIFT_CITY:  'bg-indigo-100 text-indigo-800 border border-indigo-300/50',
}[amc.categoryType] ?? 'bg-surface-container text-secondary border border-outline-variant/30';
---

<BaseLayout title={`${amc.name} | AMC Profile | PlatAlt`} currentPage="amc">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-24">

  <!-- Breadcrumb -->
  <nav class="py-6 flex items-center gap-2 text-[11px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/amc" class="hover:text-secondary transition-colors">AMC Directory</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">{amc.name}</span>
  </nav>

  <!-- AMC Header -->
  <section class="py-12 md:py-16 mb-8 border-b border-outline-variant/20">
    <div class="flex flex-col md:flex-row gap-10 items-start">
      <div class="w-24 h-24 bg-primary-container flex items-center justify-center shrink-0">
        <span class={`material-symbols-outlined text-5xl ${amc.iconColor}`} style="font-variation-settings:'FILL' 1">{amc.icon}</span>
      </div>
      <div class="flex-1">
        <div class="flex flex-wrap items-start gap-3 mb-4">
          <div>
            <span class="text-[10px] uppercase tracking-[0.3em] text-secondary font-bold mb-2 block">{amc.categoryLabel}</span>
            <h1 class="text-4xl md:text-6xl font-headline text-primary-container leading-tight">{amc.name}</h1>
          </div>
          <div class="flex flex-col gap-2 self-start mt-2">
            <span class={`px-3 py-1.5 text-[9px] uppercase font-bold tracking-widest ${categoryBadgeStyle}`}>{amc.categoryLabel}</span>
            <span class="px-3 py-1.5 bg-surface-container text-outline border border-outline-variant/30 text-[9px] uppercase font-bold tracking-widest">As on {amc.asOn}</span>
          </div>
        </div>
        <p class="text-base md:text-lg text-on-surface-variant font-light italic leading-relaxed max-w-2xl">
          {amc.tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Bar (5 cells) -->
  <section class="grid grid-cols-2 md:grid-cols-5 gap-0 bg-surface-container-lowest border border-outline-variant/20 mb-12">
    {[
      { icon: 'payments',       label: 'AUM',        value: amc.aum },
      { icon: 'calendar_today', label: 'Founded',     value: String(amc.founded) },
      { icon: 'folder_special', label: 'Strategies',  value: String(amc.strategies) },
      { icon: 'groups',         label: 'Total Clients', value: amc.clients },
      { icon: 'update',         label: 'As On',       value: amc.asOn },
    ].map((stat, i) => (
      <div class={`p-6 text-center flex flex-col items-center gap-3 ${i < 4 ? 'border-b md:border-b-0 md:border-r border-outline-variant/20' : ''}`}>
        <span class="material-symbols-outlined text-secondary text-2xl">{stat.icon}</span>
        <span class="text-[9px] uppercase tracking-widest font-bold text-outline">{stat.label}</span>
        <span class="text-xl font-headline text-primary-container leading-tight">{stat.value}</span>
      </div>
    ))}
  </section>

  <!-- About + Key Attributes -->
  <section class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
    <div class="md:col-span-7">
      <h2 class="font-headline text-4xl text-primary-container mb-6">About {amc.name}</h2>
      {amc.about.map((para: string) => (
        <p class="text-on-surface-variant text-base leading-relaxed mb-5">{para}</p>
      ))}
    </div>
    <div class="md:col-span-5">
      <div class="bg-surface-container-low p-8 h-full">
        <h3 class="font-headline text-2xl text-primary-container mb-6">Key Attributes</h3>
        <ul class="space-y-5">
          {[
            { icon: 'verified_user',   label: 'SEBI Registration',  value: amc.sebi },
            { icon: 'location_city',   label: 'Headquarters',       value: amc.hq },
            { icon: 'groups',          label: 'Investment Team',     value: amc.team },
            { icon: 'public',          label: 'Investor Base',       value: amc.investorBase },
            { icon: 'gavel',           label: 'Products',            value: amc.products },
            { icon: 'workspace_premium', label: 'Memberships',      value: amc.memberOf },
          ].map(attr => (
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 bg-surface-container flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-secondary text-lg">{attr.icon}</span>
              </div>
              <div class="min-w-0">
                <span class="block text-[10px] uppercase font-bold tracking-widest text-outline mb-0.5">{attr.label}</span>
                <span class="text-sm font-semibold text-on-surface leading-snug">{attr.value}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Investment Approach -->
  <section class="mb-16 bg-primary-container text-surface px-8 md:px-12 py-12 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="relative z-10">
      <span class="text-[10px] uppercase tracking-[0.3em] text-tertiary-fixed font-bold block mb-3">Philosophy</span>
      <h2 class="font-headline text-3xl text-tertiary-fixed mb-4">Investment <span class="italic">Approach</span></h2>
      <h3 class="font-headline text-xl text-amber-100 mb-5">{amc.approach.headline}</h3>
      <p class="text-slate-300 text-sm leading-relaxed max-w-3xl mb-10">{amc.approach.text}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {amc.approach.principles.map((p: {title: string; desc: string}) => (
          <div class="border border-secondary/30 p-6 bg-secondary/5">
            <h4 class="font-semibold text-tertiary-fixed text-sm mb-3 uppercase tracking-wide">{p.title}</h4>
            <p class="text-slate-400 text-xs leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Socials & Website -->
  <section class="mb-16 bg-surface-container-low border border-outline-variant/20 px-8 md:px-12 py-10">
    <h2 class="font-headline text-2xl text-primary-container mb-6">Connect with {amc.shortName}</h2>
    <div class="flex flex-wrap gap-4">
      <a href={amc.website} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-primary-container text-white px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:bg-secondary transition-colors">
        <span class="material-symbols-outlined text-base">language</span>Official Website
      </a>
      <a href={amc.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-outline-variant/40 text-on-surface-variant px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:border-secondary hover:text-secondary transition-colors">
        <span class="material-symbols-outlined text-base">work</span>LinkedIn
      </a>
      {amc.twitter && (
        <a href={amc.twitter} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-outline-variant/40 text-on-surface-variant px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:border-secondary hover:text-secondary transition-colors">
          <span class="material-symbols-outlined text-base">alternate_email</span>Twitter / X
        </a>
      )}
      <a href={`https://www.sebi.gov.in`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-outline-variant/40 text-on-surface-variant px-6 py-3 text-[11px] uppercase font-bold tracking-widest hover:border-secondary hover:text-secondary transition-colors">
        <span class="material-symbols-outlined text-base">verified_user</span>SEBI: {amc.sebi}
      </a>
    </div>
  </section>

  <!-- Funds Offered -->
  <section class="mb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="font-headline text-4xl text-primary-container mb-2">Funds Offered</h2>
        <div class="w-12 h-1 bg-tertiary-fixed-dim"></div>
      </div>
      <a href="/explore" class="text-[11px] font-bold uppercase tracking-widest text-secondary hover:text-primary-container flex items-center gap-1 transition-colors">
        View All Funds <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-1 bg-surface-container-low border border-outline-variant/10">
      {amc.funds.map((fund: {category: string; name: string; returns: string; aum: string; tenure: string; href: string}) => (
        <a href={fund.href} class="bg-surface-container-lowest p-8 hover:bg-white transition-all group">
          <div class="flex justify-between items-start mb-4">
            <span class="text-[9px] px-2 py-1 bg-secondary-container text-on-secondary-fixed-variant uppercase font-bold tracking-widest">{fund.category}</span>
            <span class="material-symbols-outlined text-outline-variant group-hover:text-secondary transition-colors">arrow_outward</span>
          </div>
          <h3 class="font-headline text-xl text-primary-container mb-5 group-hover:translate-x-1 transition-transform">{fund.name}</h3>
          <div class="grid grid-cols-3 gap-4 pt-5 border-t border-surface-container">
            <div>
              <span class="block text-[9px] uppercase text-outline font-bold tracking-tighter mb-1">Returns</span>
              <span class="text-base font-bold text-secondary">{fund.returns}</span>
            </div>
            <div>
              <span class="block text-[9px] uppercase text-outline font-bold tracking-tighter mb-1">AUM</span>
              <span class="text-base font-bold text-primary-container">{fund.aum}</span>
            </div>
            <div>
              <span class="block text-[9px] uppercase text-outline font-bold tracking-tighter mb-1">Tenure</span>
              <span class="text-base font-bold">{fund.tenure}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-container text-white px-10 md:px-16 py-14 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-72 h-72 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-lg">
        <span class="text-[10px] uppercase tracking-[0.3em] text-tertiary-fixed font-bold block mb-3">Institutional Enquiries</span>
        <h2 class="font-headline text-4xl text-amber-100 mb-3 leading-tight">Invest with {amc.shortName}</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Connect with our team to explore investment opportunities, mandate customisation, and onboarding with {amc.name}.
        </p>
      </div>
      <button type="button" class="js-open-consult inline-flex items-center gap-3 bg-tertiary-fixed text-on-tertiary-fixed px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity shrink-0 cursor-pointer">
        Book a Consultation <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </button>
    </div>
  </section>

</div>

</BaseLayout>
