---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAmc, getAmcSlugs, amcFunds } from '../../data/amcs';
import { PERFORMANCE_DISCLAIMER } from '../../data/funds';

export function getStaticPaths() {
  return getAmcSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const amc = getAmc(slug!);
if (!amc) return Astro.redirect('/amc');
const funds = amcFunds(slug!);

const clr = {
  PMS:       { accent: 'text-amber-300',  bg: 'bg-amber-900/25',   border: 'border-amber-700/40',  badge: 'bg-amber-900/30 text-amber-200 border border-amber-700/40'  },
  AIF_CAT1:  { accent: 'text-emerald-300',bg: 'bg-emerald-900/25', border: 'border-emerald-700/40',badge: 'bg-emerald-900/30 text-emerald-300 border border-emerald-700/40'},
  AIF_CAT2:  { accent: 'text-blue-300',   bg: 'bg-blue-900/25',    border: 'border-blue-700/40',   badge: 'bg-blue-900/30 text-blue-300 border border-blue-700/40'      },
  AIF_CAT3:  { accent: 'text-violet-300', bg: 'bg-violet-900/25',  border: 'border-violet-700/40', badge: 'bg-violet-900/30 text-violet-300 border border-violet-700/40' },
  GIFT_CITY: { accent: 'text-indigo-300', bg: 'bg-indigo-900/25',  border: 'border-indigo-700/40', badge: 'bg-indigo-900/30 text-indigo-300 border border-indigo-700/40' },
}[amc.categoryType] ?? { accent: 'text-amber-300', bg: 'bg-amber-900/25', border: 'border-amber-700/40', badge: 'bg-amber-900/30 text-amber-200 border border-amber-700/40' };

const stats = [
  { label: 'Combined AUM', value: amc.aum },
  { label: 'Strategies', value: String(amc.strategies) },
  { label: 'Categories', value: amc.categoryLabel },
];
---

<BaseLayout title={`${amc.name} | AMC Profile | Platizio Alternatives`} currentPage="amc">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-28">

  <!-- Breadcrumb -->
  <nav class="py-5 flex items-center gap-2 text-[10px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20 flex-wrap">
    <a href="/amc" class="hover:text-secondary transition-colors">AMC Directory</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">{amc.name}</span>
  </nav>

  <!-- Hero -->
  <section class="pt-10 pb-8 border-b border-outline-variant/20">
    <div class="flex items-start gap-6">
      <div class={`w-16 h-16 ${clr.bg} ${clr.border} border flex items-center justify-center shrink-0`}>
        <span class={`material-symbols-outlined text-3xl ${clr.accent}`}>{amc.icon}</span>
      </div>
      <div class="flex-1">
        <span class={`text-[10px] px-3 py-1.5 uppercase font-bold tracking-widest ${clr.badge}`}>{amc.categoryLabel}</span>
        <h1 class="text-4xl md:text-6xl font-headline text-primary-container leading-tight mt-4 mb-3">{amc.name}</h1>
        <p class="text-sm text-on-surface-variant max-w-2xl leading-relaxed">{amc.tagline}</p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-3 border border-outline-variant/20 mb-12">
    {stats.map((s, i) => (
      <div class={`px-6 py-5 ${i < stats.length - 1 ? 'border-b sm:border-b-0 sm:border-r border-outline-variant/20' : ''}`}>
        <p class="text-[9px] uppercase tracking-widest font-bold text-outline mb-1.5">{s.label}</p>
        <p class="text-sm font-bold text-primary-container leading-tight">{s.value}</p>
      </div>
    ))}
  </div>

  <!-- Funds -->
  <section class="mb-12">
    <div class="flex items-center gap-3 mb-6">
      <span class={`material-symbols-outlined ${clr.accent}`} style="font-variation-settings:'FILL' 1">inventory_2</span>
      <h2 class="font-headline text-2xl text-primary-container">Funds on Platizio Alternatives</h2>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant/10 divide-y divide-outline-variant/10">
      {funds.map((f) => (
        <a href={f.href} class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-8 py-5 hover:bg-surface-container-low transition-colors group">
          <div>
            <span class={`text-[10px] uppercase tracking-widest font-bold ${clr.accent}`}>{f.category}</span>
            <h3 class="font-headline text-lg text-primary-container group-hover:translate-x-0.5 transition-transform">{f.name}</h3>
          </div>
          <div class="flex items-center gap-6 shrink-0">
            <div class="text-right">
              <span class="block text-[9px] uppercase text-outline font-bold tracking-tighter">AUM</span>
              <span class="text-sm font-bold text-primary-container">{f.aum}</span>
            </div>
            <span class="material-symbols-outlined text-secondary">arrow_forward</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-outline-variant/20 pt-6">
    <p class="text-[10px] text-outline-variant leading-relaxed max-w-3xl">{PERFORMANCE_DISCLAIMER}</p>
  </section>

</div>
</BaseLayout>
