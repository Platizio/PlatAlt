---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Meridian Prime Partners | AMC Profile | PlatAlt" currentPage="products/amc">

<div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 pb-24">

  <!-- Breadcrumb -->
  <nav class="py-6 flex items-center gap-2 text-[11px] uppercase tracking-widest font-bold text-outline border-b border-outline-variant/20">
    <a href="/amc" class="hover:text-secondary transition-colors">AMC Directory</a>
    <span class="material-symbols-outlined text-sm text-outline-variant">chevron_right</span>
    <span class="text-on-surface-variant">Meridian Prime Partners</span>
  </nav>

  <!-- AMC Header -->
  <section class="py-12 md:py-16 mb-8 border-b border-outline-variant/20">
    <div class="flex flex-col md:flex-row gap-10 items-start">
      <!-- Logo Area -->
      <div class="w-24 h-24 bg-primary-container flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-5xl text-tertiary-fixed" style="font-variation-settings:'FILL' 1">account_balance</span>
      </div>
      <div class="flex-1">
        <div class="flex flex-wrap items-start gap-4 mb-4">
          <div>
            <span class="text-[10px] uppercase tracking-[0.3em] text-secondary font-bold mb-2 block">Premier Partner</span>
            <h1 class="text-4xl md:text-6xl font-headline text-primary-container leading-tight">Meridian Prime Partners</h1>
          </div>
          <span class="px-4 py-2 bg-tertiary-fixed text-on-tertiary-fixed text-[10px] uppercase font-bold tracking-widest self-start mt-2">AAA Rated</span>
        </div>
        <p class="text-lg text-on-surface-variant font-light italic leading-relaxed max-w-2xl">
          "Exclusive access to Tier-1 infrastructure, private equity, and alternative credit opportunities for the discerning institutional allocator."
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-0 bg-surface-container-lowest border border-outline-variant/20 mb-12">
    {[
      { icon: 'payments', label: 'AUM', value: '₹28,400 Cr' },
      { icon: 'calendar_today', label: 'Founded', value: '2006' },
      { icon: 'folder_special', label: 'Strategies', value: '14' },
      { icon: 'verified', label: 'Rating', value: 'AAA' },
    ].map((stat, i) => (
      <div class={`p-8 text-center flex flex-col items-center gap-3 ${i < 3 ? 'border-b md:border-b-0 md:border-r border-outline-variant/20' : ''}`}>
        <span class="material-symbols-outlined text-secondary text-2xl">{stat.icon}</span>
        <span class="text-[10px] uppercase tracking-widest font-bold text-outline">{stat.label}</span>
        <span class="text-2xl font-headline text-primary-container">{stat.value}</span>
      </div>
    ))}
  </section>

  <!-- About Section – 2-col -->
  <section class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
    <div class="md:col-span-7">
      <h2 class="font-headline text-4xl text-primary-container mb-6">About Meridian Prime Partners</h2>
      <p class="text-on-surface-variant text-base leading-relaxed mb-5">
        Meridian Prime Partners is a SEBI-registered Category I and II Alternative Investment Fund Manager headquartered in Mumbai, with offices in Delhi, Bengaluru, and Singapore. Founded in 2006 by former sovereign wealth fund executives, the firm has built a reputation for rigorous underwriting discipline and long-term value creation across infrastructure, private equity, and structured credit.
      </p>
      <p class="text-on-surface-variant text-base leading-relaxed mb-5">
        The firm manages capital on behalf of pension funds, family offices, insurance companies, endowments, and high-net-worth individuals who demand institutional-grade transparency and governance. Its investment committee comprises veterans from global bulge-bracket institutions with an aggregate of over 120 years of alternative investment experience.
      </p>
      <p class="text-on-surface-variant text-base leading-relaxed">
        Meridian Prime Partners is a registered member of the Indian Venture and Alternate Capital Association (IVCA) and maintains ISAE 3000-compliant reporting standards across all managed vehicles.
      </p>
    </div>
    <div class="md:col-span-5">
      <div class="bg-surface-container-low p-8 h-full">
        <h3 class="font-headline text-2xl text-primary-container mb-6">Key Attributes</h3>
        <ul class="space-y-5">
          {[
            { icon: 'verified_user', label: 'SEBI Registration', value: 'IN/AIF1/14-15/0080' },
            { icon: 'location_city', label: 'Headquarters', value: 'Mumbai, Maharashtra' },
            { icon: 'groups', label: 'Investment Team', value: '48 Professionals' },
            { icon: 'public', label: 'Investor Base', value: 'Domestic & International' },
            { icon: 'gavel', label: 'AIF Categories', value: 'Category I & II' },
            { icon: 'workspace_premium', label: 'IVCA Member', value: 'Since 2009' },
          ].map(attr => (
            <li class="flex items-center gap-4">
              <div class="w-10 h-10 bg-surface-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-secondary text-lg">{attr.icon}</span>
              </div>
              <div>
                <span class="block text-[10px] uppercase font-bold tracking-widest text-outline">{attr.label}</span>
                <span class="text-sm font-semibold text-on-surface">{attr.value}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Funds Offered -->
  <section class="mb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="font-headline text-4xl text-primary-container mb-2">Funds Offered</h2>
        <div class="w-12 h-1 bg-tertiary-fixed-dim"></div>
      </div>
      <a href="/explore" class="text-[11px] font-bold uppercase tracking-widest text-secondary hover:text-primary flex items-center gap-1 transition-colors">
        View All <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-1 bg-surface-container-low border border-outline-variant/10">
      {[
        { category: 'Infrastructure • Category II', name: 'Meridian Infrastructure Growth Fund III', returns: '14.2% IRR', aum: '₹8,200 Cr', tenure: '7 Years' },
        { category: 'Private Equity • Category II', name: 'Meridian India Buyout Fund II', returns: '18.7% IRR', aum: '₹12,400 Cr', tenure: '8 Years' },
        { category: 'Structured Credit • Category II', name: 'Meridian Yield Opportunities Fund', returns: '11.5% YTM', aum: '₹5,600 Cr', tenure: '5 Years' },
        { category: 'Venture Capital • Category I', name: 'Meridian Deep Tech Fund I', returns: '22.1% IRR', aum: '₹2,200 Cr', tenure: '10 Years' },
      ].map(fund => (
        <a href="/explore" class="bg-surface-container-lowest p-8 hover:bg-white transition-all group">
          <div class="flex justify-between items-start mb-4">
            <span class="text-[10px] px-2 py-1 bg-secondary-container text-on-secondary-fixed-variant uppercase font-bold tracking-widest">{fund.category}</span>
            <span class="material-symbols-outlined text-outline-variant group-hover:text-secondary transition-colors">arrow_outward</span>
          </div>
          <h3 class="font-headline text-xl text-primary-container mb-5 group-hover:translate-x-1 transition-transform">{fund.name}</h3>
          <div class="grid grid-cols-3 gap-4 pt-5 border-t border-surface-container">
            <div>
              <span class="block text-[10px] uppercase text-outline font-bold tracking-tighter mb-1">Returns</span>
              <span class="text-base font-bold text-secondary">{fund.returns}</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-outline font-bold tracking-tighter mb-1">AUM</span>
              <span class="text-base font-bold">{fund.aum}</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-outline font-bold tracking-tighter mb-1">Tenure</span>
              <span class="text-base font-bold">{fund.tenure}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Contact / Partnership CTA -->
  <section class="bg-primary-container text-white px-10 md:px-16 py-14 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-72 h-72 bg-secondary/10 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-lg">
        <span class="text-[10px] uppercase tracking-[0.3em] text-tertiary-fixed font-bold block mb-3">Institutional Enquiries</span>
        <h2 class="font-headline text-4xl text-amber-100 mb-3 leading-tight">Partner with Meridian Prime Partners</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Connect with our institutional relations team to explore co-investment opportunities, separate accounts, and bespoke mandates.
        </p>
      </div>
      <a href="/partner" class="inline-flex items-center gap-3 bg-tertiary-fixed text-on-tertiary-fixed px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:opacity-90 transition-opacity shrink-0">
        Contact Partnership Office <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </section>

</div>

</BaseLayout>
