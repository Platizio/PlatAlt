---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Meridian Insights | The Sovereign Ledger" currentPage="media">

<!-- Hero Section -->
<section class="relative h-[75vh] min-h-[500px] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img class="w-full h-full object-cover" alt="Glass and steel skyscraper at blue hour"
         src="https://lh3.googleusercontent.com/aida-public/AB6AXuCflpyFpcOFsdXiv8VJ67NI2MkeY7BMIEEw2D3dXTVaCyWjzCmZxvW6qJHtLLl2kILtU98_qsYY6rmQzGg_2nNsAPjq349DXgnT3EOekIPBQ9e6vAkGUfmUdgulhkAOcKXB2HKYt8RzL0z5msAmXFFTq9uWz1mHaJLaLQMb4urFJveEBSKB_WBrnjPvGwZ7_bSu78P1k5zpPP4RBR5Wbcu8bpNZfhmFS54eEsmjRhLREYoT1IckvU6z8LwBwPMknaHywmFvzyCBi-g" />
    <div class="absolute inset-0 bg-gradient-to-t from-primary-container via-primary-container/40 to-transparent"></div>
  </div>
  <div class="relative z-10 w-full max-w-screen-2xl mx-auto px-8 text-center md:text-left">
    <div class="max-w-3xl">
      <span class="inline-block px-3 py-1 bg-tertiary-fixed/20 text-tertiary-fixed text-[10px] uppercase tracking-widest mb-6 border border-tertiary-fixed/30 backdrop-blur-md">Quarterly Report</span>
      <h1 class="text-5xl md:text-8xl font-serif italic text-amber-100 tracking-tight leading-[1.1] mb-8">Meridian Insights</h1>
      <p class="text-xl md:text-2xl text-slate-300 max-w-2xl leading-relaxed mb-10">
        Strategic foresight for the sovereign investor. Curated perspectives on wealth preservation and global market evolution.
      </p>
      <div class="flex flex-col sm:flex-row gap-6">
        <button class="bg-primary-container text-amber-200 px-8 py-4 text-xs font-semibold uppercase tracking-widest border border-amber-200/30 hover:bg-amber-200 hover:text-primary-container transition-all duration-500">
          Explore Archives
        </button>
        <a href="/knowledge/article" class="text-amber-100 px-8 py-4 text-xs font-semibold uppercase tracking-widest flex items-center gap-2 group">
          Latest Briefing <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Masterclass Series: Editorial Grid -->
<section class="py-24 bg-surface px-8">
  <div class="max-w-screen-2xl mx-auto">
    <div class="flex justify-between items-end mb-16 border-b border-outline-variant/20 pb-6">
      <div>
        <h2 class="text-4xl font-serif italic text-primary-container">Masterclass Series</h2>
        <p class="text-secondary mt-2">Visual deep-dives into macroeconomic trends.</p>
      </div>
      <a class="text-primary-container text-[11px] font-bold uppercase tracking-widest flex items-center gap-2 hover:opacity-70 transition-opacity" href="#">
        View All Films <span class="material-symbols-outlined text-sm">open_in_new</span>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Featured Video -->
      <div class="md:col-span-8 group cursor-pointer">
        <div class="relative aspect-video overflow-hidden mb-6">
          <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
               alt="Financial visualization in 3D space"
               src="https://lh3.googleusercontent.com/aida-public/AB6AXuCaoPzo43NYRA9N58FMLKxCf3cU5pev17sLk_uf8mOXBf1AJEdTfRveC1QeytLg4h7ylfa7ebXLxo5QTioSKT1v3PgyztP53MeX9oV0GflY1-eBClc89tGF9llcxxC9sOVlZUQethCDLdfCcz37WQ9eHqp5Eke-sQAY85jn-W8_waeSd7Sufo4URQ6mshVNjCopO1qa6U9xfh4fdfASFOesQ_mEm0mvfp0AL4m9UwwU-q60g2xjaMap8DPCTUtylUOOZQPGJs5xKx8" />
          <div class="absolute inset-0 bg-primary-container/20 flex items-center justify-center">
            <div class="w-20 h-20 rounded-full bg-amber-200/90 flex items-center justify-center shadow-2xl scale-90 group-hover:scale-100 transition-transform duration-300">
              <span class="material-symbols-outlined text-primary-container text-4xl" style="font-variation-settings:'FILL' 1,'wght' 300,'GRAD' 0,'opsz' 24">play_arrow</span>
            </div>
          </div>
        </div>
        <span class="text-on-tertiary-container font-bold text-[10px] uppercase tracking-widest">Documentary Short</span>
        <h3 class="text-3xl font-serif italic text-primary-container mt-2 mb-4">The Sovereign's Dilemma: Liquidity in a Post-Digital Age</h3>
        <p class="text-secondary leading-relaxed max-w-xl">A 20-minute masterclass examining the shifting nature of store-of-value assets and the institutional migration toward private ledgers.</p>
      </div>
      <!-- Side Videos -->
      <div class="md:col-span-4 flex flex-col gap-10">
        {[
          { title: 'Fiscal Year Projections', ep: 'Episode 42 • 14:05', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDCQRikyd7_eidkylAXQBTtHiU-464UX1fxtIdfZcvUBD2ZPnQTYt5_mgg-U0gh5-eoeGjZ3eGl4Oxq3K1VlDbarP9kR-5rZtq_zWOOWcTxyyOwysHXijabWv-DY3bT5FeySxdDHcLxv8yEZMEb9Rip5MIgFWieWB913WgkEMVQGCBGmUsJdr1JwvX4xDP5thU73FdiP5HE6OJ0RJwMnpGN-m9SK6C-Bm7gAJ73XaqOy2Kmr4m4tzsf1dmnf0idCWHyzQhPfB8iMV0' },
          { title: 'Architecting the Vault', ep: 'Episode 41 • 09:22', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAc8h_TaZYLySqQMq0I2Qj03UWb-_qDQgq5WqxVhjuBdwdPce7DCTB01FZkmyKtIMOyrDlUbrf36mvEI9UcJZj7dux6fKEm_Z1BjaSMzG1HlwM6nzBhKfiBi6GLH5Ja8HF7T2MgrIEMPGro-AIW5cASxGNdR6AwlCQfSlTqtiM8d1xt7i8_uQLV-yHyrJC9tULiCY_5_r0Mo2lUrClOelBrh7hV9RO0VzTikAeh9-Yo_6hU6gIX9NWI9mxAC6KFuP5qAQaVmXdx5Os' },
          { title: 'Blockchain Sovereignty', ep: 'Episode 40 • 18:44', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDS72rekyvFjtbsr9YKiAsnduTAENr2h4R-YWpOhKia4DGqR4kYXGVE6kaZYasF98Sq5Z--PtEp6SFTqz8y_5roN6tmp2O_GN0J4gSlzojCczP5kUtvNOzpQFYn4-uPR0ppqgkYDIE69nkidSRqB5HEBJmQAiKLde48dlK2XIXmTotEci429sNmIolxp4pXe8EsUZuq-YQgv6J_jlPwVl8d7D-zFQ_44eyS6zDsqlUk94K6X10FjPDCRdNMy73zC_Z5e8yA__1WTmA' },
        ].map(v => (
          <div class="group flex gap-4 cursor-pointer">
            <div class="w-32 h-20 flex-shrink-0 overflow-hidden">
              <img class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" alt={v.title} src={v.src} />
            </div>
            <div>
              <h4 class="font-serif italic text-xl text-primary-container mb-1">{v.title}</h4>
              <p class="text-[12px] text-secondary">{v.ep}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Articles & Blogs: Bento/Editorial Layout -->
<section class="py-24 bg-surface-container-low px-8">
  <div class="max-w-screen-2xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="text-4xl font-serif italic text-primary-container">The Journal</h2>
      <div class="w-20 h-[1px] bg-amber-200 mx-auto mt-6"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {[
        { cat: 'Philanthropy • 8 Min Read', title: 'The Altruism Ledger: Balancing Legacy and Capital Efficiency', desc: 'How modern estates are redefining their charitable foundations through structured sovereign instruments.', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDOIH_wepsjlxc19oveUkuKUFFplwu3fQyTYgzLuyq7UoVnYNOrQyS4LRlGoQDM_xiw2MpGSeHiaTSli1VYlQEPaVu7zx2Gwb11bLHKdCQTwfgzOiSWm8GbIIZev3CCxvuICw4T1j_UFz5YvQbly1o5jBol6HQcPDuvCXjbHI7vkNqhDxZ39VFxE1wcEP8IMXyOvkqkaE8lR6QAYyFtXIL8t94AKL6cAt3-edqarHhH2N5eBle8zO_ernJk_BSicV3q3CyE5XLK8ZM', offset: false },
        { cat: 'Markets • 12 Min Read', title: 'Hard Assets in a Soft Era: Reclaiming Tangibility', desc: 'An analysis of why traditional physical gold and real estate are becoming the ultimate hedge against digital volatility.', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCNYzxpZQSW4fAvUGJhyf7ttDg5aX0a8d-LfgYOyIuEgO1IGeog1xuucCrxNv88HoqSUVBGjeNNogjxOU7j92iiguke8_GIpUsQEubz1Xdxnw1ZGOHfNDDRZPoUvpG2GyGbnEbdvAbU114_5KOQEH2hJUc1B1CmkUnCy_EMqii434EJ_9sY1Mvtsx_T_cmyv-oxwQyVi-m_jCMymqkByLCy8x7gfAHXXa-fGCxX7yoI-ta9SE8VSZlWlZ-xlxn97dpWW0osxQXyM6I', offset: true },
        { cat: 'Technology • 10 Min Read', title: 'The Geopolitical Sandbox: Wealth on the Frontier', desc: 'Navigating jurisdictional arbitrage and the emergence of private special economic zones.', src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDtRdRGDGN6EKlyAI-pyrhzf9KhY_lbtBw42kxNJlADeteXoSGZotVP_ImYg4_eH1HfcBaK_NSsD0t9gB92dsAi3VBvXNNGTy0BQrg1TqfDEluDCoH5ceL7uYtl8cDuXaWFFExShK6-wV-nD-dQ5HWg75d7-kajXe4jB1mk8wml7phu_hi30vWsRX3I10AAPq82lPvxK1sIpePDi-kqNw17Qu28ue87SvPbJYgHJWhywJI0FmObRZuNFLwPKKYZGIIe5LQICSnXod0', offset: false },
      ].map((a, i) => (
        <div class={`flex flex-col ${i === 1 ? 'md:mt-12' : ''}`}>
          <img class="w-full aspect-[4/5] object-cover mb-8 brightness-90" alt={a.title} src={a.src} />
          <span class="text-[10px] uppercase tracking-widest text-secondary font-bold">{a.cat}</span>
          <h3 class="text-2xl font-serif italic text-primary-container mt-4 mb-6 leading-snug">{a.title}</h3>
          <p class="text-on-surface-variant mb-8 leading-relaxed">{a.desc}</p>
          <a class="mt-auto border-b border-primary-container w-max pb-1 text-[11px] font-bold uppercase tracking-widest hover:text-amber-700 transition-colors" href="/knowledge/article">Read Article</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Market Pulse -->
<section class="py-24 bg-primary-container text-amber-100 px-8">
  <div class="max-w-screen-2xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
    <div class="md:col-span-4">
      <h2 class="text-4xl font-serif italic mb-6">Market Pulse</h2>
      <p class="text-slate-400 mb-8">Real-time intelligence from our global desk. Stay informed of movements before they become headlines.</p>
      <div class="space-y-4">
        <div class="flex items-center gap-4 text-[11px] font-bold tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE UPDATES
        </div>
        <div class="flex items-center gap-4 text-[11px] font-bold tracking-widest text-slate-500">
          EST 14:32:01 • TOKYO OPEN
        </div>
      </div>
    </div>
    <div class="md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8">
      {[
        { tag: 'BREAKING • 15M AGO', text: 'Swiss National Bank adjusts reserve ratios for digital custody.' },
        { tag: 'ANALYSIS • 1H AGO', text: 'Emerging market bond yields hit 10-year resistance levels.' },
        { tag: 'QUARTERLY • 3H AGO', text: 'Private Equity inflows reach record highs in the APAC region.' },
        { tag: 'INSIGHT • 5H AGO', text: 'The resurgence of semi-precious commodities in family offices.' },
      ].map(n => (
        <div class="bg-slate-800/40 p-8 border-l-2 border-amber-200/40 hover:bg-slate-800/60 transition-colors cursor-pointer">
          <span class="text-amber-200/60 text-[10px] font-bold tracking-widest">{n.tag}</span>
          <h4 class="text-xl font-serif italic mt-3">{n.text}</h4>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="py-32 bg-surface">
  <div class="max-w-4xl mx-auto px-8 text-center">
    <span class="material-symbols-outlined text-5xl text-amber-600 mb-8 block">mail_outline</span>
    <h2 class="text-5xl font-serif italic text-primary-container mb-6">The Meridian Brief</h2>
    <p class="text-secondary text-lg mb-12">Join 12,000+ high-net-worth professionals who receive our weekly curated synthesis of capital, power, and heritage.</p>
    <form class="flex flex-col sm:flex-row gap-0 max-w-2xl mx-auto border-b border-primary-container group">
      <input class="flex-grow bg-transparent border-none py-4 px-0 focus:ring-0 text-primary-container placeholder:text-slate-400 italic text-lg" placeholder="Professional Email Address" type="email" />
      <button class="py-4 px-8 text-xs font-bold uppercase tracking-[0.2em] text-primary-container hover:text-amber-700 transition-colors" type="submit">Join the Ledger</button>
    </form>
    <p class="text-[10px] text-slate-400 mt-6 uppercase tracking-widest">Respecting privacy since 1994 • No third-party sharing</p>
  </div>
</section>

</BaseLayout>
