---
import BaseLayout from '../layouts/BaseLayout.astro';

// Uploads playlist of the Platizio Alternatives YouTube channel
// (channel UCriQiBtwCdiNAvNdJBqYcyw -> uploads playlist UU...). Embedding the
// uploads playlist means the page always reflects the channel, with no code
// change when a new video is published.
const CHANNEL_URL = 'https://www.youtube.com/@platizioalternatives';
const UPLOADS_PLAYLIST = 'UUriQiBtwCdiNAvNdJBqYcyw';

const knowledgeLinks = [
  {
    tag: 'Alternative Investment Funds',
    title: 'AIF Knowledge Centre',
    desc: 'Structure, taxation and regulatory limits across SEBI Category I, II and III funds.',
    href: '/knowledge/aif',
  },
  {
    tag: 'Portfolio Management',
    title: 'Portfolio Management Services',
    desc: 'How discretionary, non-discretionary and advisory PMS mandates differ in practice.',
    href: '/knowledge/pms',
  },
  {
    tag: 'Comparison',
    title: 'AIF Category Comparison',
    desc: 'Category I, II and III side by side - eligibility, leverage, tenure and tax treatment.',
    href: '/knowledge/aif-comparison',
  },
  {
    tag: 'GIFT IFSC',
    title: 'Investing through GIFT City',
    desc: 'The IFSC route for non-resident and foreign-currency allocations to Indian strategies.',
    href: '/gift-city',
  },
];
---
<BaseLayout
  currentPage="media"
>

<!-- Hero -->
<section class="bg-primary-container text-white">
  <div class="max-w-screen-2xl mx-auto px-8 py-24 md:py-32 text-center">
    <span class="text-[11px] font-bold uppercase tracking-[0.3em] text-tertiary-fixed block mb-6">Market Insights</span>
    <h1 class="text-5xl md:text-7xl font-serif italic text-amber-100 tracking-tight leading-[1.1] mb-8">
      Commentary and <span class="not-italic font-semibold text-tertiary-fixed">Research</span>
    </h1>
    <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
      Video explainers and written guides on alternative investments in India - how these
      structures work, what they cost, and the rules that govern them.
    </p>
  </div>
</section>

<!-- Video Library -->
<section class="py-24 bg-surface px-8">
  <div class="max-w-screen-2xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12 border-b border-outline-variant/20 pb-6">
      <div>
        <h2 class="text-4xl font-serif italic text-primary-container">Video Library</h2>
        <p class="text-secondary mt-2">Latest from the Platizio Alternatives channel.</p>
      </div>
      <a
        class="text-primary-container text-[11px] font-bold uppercase tracking-widest flex items-center gap-2 hover:opacity-70 transition-opacity"
        href={CHANNEL_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        View channel on YouTube <span class="material-symbols-outlined text-sm">open_in_new</span>
      </a>
    </div>

    <div class="relative w-full aspect-video bg-primary-container max-w-5xl mx-auto">
      <iframe
        class="absolute inset-0 w-full h-full"
        src={`https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS_PLAYLIST}`}
        title="Platizio Alternatives - video library"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
    <p class="text-center text-xs text-outline mt-5 uppercase tracking-widest">
      Use the playlist control in the player to browse all episodes
    </p>
  </div>
</section>

<!-- Written Guides -->
<section class="py-24 bg-surface-container-low px-8">
  <div class="max-w-screen-2xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif italic text-primary-container">Written Guides</h2>
      <div class="w-20 h-[1px] bg-tertiary-fixed-dim mx-auto mt-6"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {knowledgeLinks.map((item) => (
        <a
          href={item.href}
          class="group bg-surface-container-lowest p-8 flex flex-col border border-transparent hover:border-outline-variant/30 hover:shadow-md transition-all"
        >
          <span class="text-[10px] font-bold uppercase tracking-widest text-secondary mb-3">{item.tag}</span>
          <h3 class="text-2xl font-serif italic text-primary-container mb-4 leading-snug">{item.title}</h3>
          <p class="text-on-surface-variant leading-relaxed mb-8">{item.desc}</p>
          <span class="mt-auto flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-primary-container">
            Read guide
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="py-28 bg-surface">
  <div class="max-w-4xl mx-auto px-8 text-center">
    <span class="material-symbols-outlined text-5xl text-secondary mb-8 block">mail_outline</span>
    <h2 class="text-4xl md:text-5xl font-serif italic text-primary-container mb-6">Stay Informed</h2>
    <p class="text-secondary text-lg mb-12">
      Occasional updates when we publish new research or video commentary. No promotional mail.
    </p>
    <form class="flex flex-col sm:flex-row gap-0 max-w-2xl mx-auto border-b border-primary-container">
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        required
        class="flex-grow bg-transparent border-none py-4 px-0 focus:ring-0 text-primary-container placeholder:text-slate-400 italic text-lg"
        placeholder="Email address"
        type="email"
      />
      <button
        class="py-4 px-8 text-xs font-bold uppercase tracking-[0.2em] text-primary-container hover:text-amber-700 transition-colors"
        type="submit"
      >
        Subscribe
      </button>
    </form>
    <p class="text-[10px] text-slate-400 mt-6 uppercase tracking-widest">
      We do not share your address with third parties
    </p>
  </div>
</section>

</BaseLayout>
